				assigned-clocks = <0xae 0x2d 0xae 0x33 0xae 0x35>;
				assigned-clock-parents = <0x42 0x01 0x42 0x02 0x42 0x02>;
				operating-points-v2 = <0xf0>;
				power-domains = <0xaf 0x06>;
				phys = <0x42 0x01>;
				phy-names = "dp";
				#sound-dai-cells = <0x00>;
				status = "okay";

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0xf5>;
							phandle = <0xea>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0xf6>;
							phandle = <0xd7>;
						};
					};
				};
			};

			displayport-controller@af6c000 {
				compatible = "qcom,glymur-dp";
				reg = <0x00 0xaf6c000 0x00 0x200 0x00 0xaf6c200 0x00 0x200 0x00 0xaf6d000 0x00 0xc00 0x00 0xaf6e000 0x00 0x400 0x00 0xaf6f000 0x00 0x400 0x00 0xaf70000 0x00 0x400 0x00 0xaf71000 0x00 0x400 0x00 0xaf72000 0x00 0x600 0x00 0xaf73000 0x00 0x600>;
				interrupts-extended = <0xe5 0x0f>;
				clocks = <0xae 0x06 0xae 0x37 0xae 0x39 0xae 0x3e 0xae 0x3f>;
				clock-names = "core_iface", "core_aux", "ctrl_link", "ctrl_link_iface", "stream_pixel";
				assigned-clocks = <0xae 0x3a 0xae 0x40>;
				assigned-clock-parents = <0xf7 0x00 0xf7 0x01>;
				operating-points-v2 = <0xf0>;
				power-domains = <0xaf 0x06>;
				phys = <0xf7>;
				phy-names = "dp";
				status = "okay";

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0xf8>;
							phandle = <0xe9>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							data-lanes = <0x00 0x01 0x02 0x03>;
							link-frequencies = <0x00 0x608f3d00 0x00 0xa0eebb00 0x01 0x41dd7600 0x01 0xe2cc3100>;
							remote-endpoint = <0xf9>;
							phandle = <0xfc>;
						};
					};
				};

				aux-bus {

					panel {
						compatible = "samsung,atna60cl08", "samsung,atna33xc20";
						enable-gpios = <0x69 0x12 0x00>;
						power-supply = <0xfa>;
						pinctrl-0 = <0xfb>;
						pinctrl-names = "default";

						port {

							endpoint {
								remote-endpoint = <0xfc>;
								phandle = <0xf9>;
							};
						};
					};
				};
			};
		};

		clock-controller@af00000 {
			compatible = "qcom,glymur-dispcc";
			reg = <0x00 0xaf00000 0x00 0x20000>;
			clocks = <0x3a 0x00 0x3b 0x40 0x01 0x40 0x02 0x41 0x01 0x41 0x02 0x42 0x01 0x42 0x02 0xf7 0x00 0xf7 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
			power-domains = <0xaf 0x06>;
			required-opps = <0xc3>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			phandle = <0xae>;
			status = "okay";
		};

		interrupt-controller@b220000 {
			compatible = "qcom,glymur-pdc", "qcom,pdc";
			reg = <0x00 0xb220000 0x00 0x10000>;
			qcom,pdc-ranges = <0x00 0x2e9 0x33 0x33 0x20f 0x2f 0x62 0x261 0x20 0x82 0x2cd 0x0c 0x8e 0xfb 0x05 0x93 0x31c 0x10 0xab 0x1008 0x24>;
