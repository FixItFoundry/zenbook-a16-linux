		pmcx0102-d0-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x116>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};

