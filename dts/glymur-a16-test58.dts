				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};
	};

	aliases {
		serial0 = "/soc@0/geniqup@8c0000/serial@894000";
		serial1 = "/soc@0/geniqup@ac0000/serial@a98000";
		i2c0 = "/soc@0/geniqup@bc0000/i2c@b80000";
		i2c1 = "/soc@0/geniqup@bc0000/i2c@b90000";
		i2c2 = "/soc@0/geniqup@bc0000/i2c@b94000";
		spi0 = "/soc@0/geniqup@8c0000/spi@888000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			clock-frequency = <0x249f000>;
			#clock-cells = <0x00>;
			phandle = <0x10a>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x7d00>;
			#clock-cells = <0x00>;
			phandle = <0x3b>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x11f>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <0x73>;
			gpios = <0xff 0x06 0x01>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	regulator-nvme {
		compatible = "regulator-fixed";
		regulator-name = "VREG_NVME_3P3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0xff 0x0e 0x00>;
		enable-active-high;
		pinctrl-0 = <0x120>;
		pinctrl-names = "default";
		regulator-boot-on;
		phandle = <0xca>;
	};

	regulator-nvmesec {
		compatible = "regulator-fixed";
		regulator-name = "VREG_NVME_SEC_3P3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x107 0x0e 0x00>;
		enable-active-high;
		pinctrl-0 = <0x121>;
		pinctrl-names = "default";
		regulator-boot-on;
		phandle = <0xd2>;
	};

	regulator-wcn-0p95 {
		compatible = "regulator-fixed";
		regulator-name = "VREG_WCN_0P95";
		regulator-min-microvolt = <0xe7ef0>;
		regulator-max-microvolt = <0xe7ef0>;
		vin-supply = <0x122>;
		phandle = <0x125>;
	};

	regulator-wcn-3p3 {
		compatible = "regulator-fixed";
		regulator-name = "VREG_WCN_3P3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x69 0x5e 0x00>;
		enable-active-high;
		pinctrl-0 = <0x123>;
		pinctrl-names = "default";
		regulator-boot-on;
		phandle = <0x122>;
	};

	regulator-wwan {
		compatible = "regulator-fixed";
		regulator-name = "VREG_WWAN_3P3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x69 0xf6 0x00>;
		enable-active-high;
		pinctrl-0 = <0x124>;
		pinctrl-names = "default";
		phandle = <0xcf>;
	};

	edp-3v3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "edp_3v3";
		gpio = <0x69 0x46 0x00>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	wcn7850-pmu {
		compatible = "qcom,wcn7850-pmu";
		vdd-supply = <0x125>;
		vddio-supply = <0x6b>;
		vddaon-supply = <0x6b>;
		vdddig-supply = <0x6b>;
		vddrfa1p2-supply = <0x6b>;
		vddrfa1p8-supply = <0x6b>;
		wlan-enable-gpios = <0x69 0x75 0x00>;
		bt-enable-gpios = <0x69 0x74 0x00>;
		pinctrl-0 = <0x126>;
		pinctrl-names = "default";

		regulators {

			ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
				phandle = <0x85>;
			};

			ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
				phandle = <0x82>;
			};

			ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
				phandle = <0x83>;
			};

			ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
				phandle = <0x84>;
			};

			ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
				phandle = <0x86>;
			};

			ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
				phandle = <0x87>;
			};

			ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
				phandle = <0x88>;
			};

			ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
				phandle = <0xc4>;
			};

			ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
				phandle = <0xc5>;
			};
		};
	};

	pmic-glink {
		compatible = "qcom,glymur-pmic-glink", "qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x127>;
						phandle = <0xda>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x128>;
						phandle = <0xb4>;
					};
				};
			};
		};

		connector@1 {
			compatible = "usb-c-connector";
			reg = <0x01>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x129>;
						phandle = <0xdd>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x12a>;
						phandle = <0xb9>;
					};
				};
			};
		};
	};

	regulator-edp-3p3 {
		compatible = "regulator-fixed";
		regulator-name = "VREG_EDP_3P3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x69 0x46 0x00>;
		enable-active-high;
		pinctrl-0 = <0x12b>;
		pinctrl-names = "default";
		regulator-boot-on;
		phandle = <0xfa>;
	};

	regulator-misc-3p3 {
		compatible = "regulator-fixed";
		regulator-name = "VREG_MISC_3P3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x100 0x06 0x00>;
		enable-active-high;
		pinctrl-0 = <0x12c>;
		pinctrl-names = "default";
		regulator-boot-on;
		phandle = <0x6a>;
	};

	soccp_glink_edge {
		compatible = "asus,soccp-glink";

		glink-edge {
			label = "soccp";
			qcom,remote-pid = <0x13>;
			mboxes = <0x39 0x2e 0x00>;
			interrupts-extended = <0x39 0x2e 0x00 0x01>;
		};
	};
};
