/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Qualcomm Technologies, Inc. Glymur CRD";
	compatible = "qcom,glymur-crd", "qcom,glymur";

	sound {
		compatible = "qcom,glymur-sndcard";
		model = "GLYMUR-A16";
		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT", "TweeterLeft IN", "WSA WSA_SPK2 OUT", "WooferRight IN", "WSA2 WSA_SPK1 OUT", "TweeterRight IN", "WSA2 WSA_SPK2 OUT", "VA DMIC0", "vdd-micb", "VA DMIC1", "vdd-micb", "VA DMIC2", "vdd-micb", "VA DMIC3", "vdd-micb";

		wsa-dai-link {
			link-name = "WSA Playback";

			cpu {
				sound-dai = <0x202 0x69>;
			};

			codec {
				sound-dai = <0x246 0x247 0x244 0x00 0x240 0x00 0x248 0x249 0x245 0x00 0x241 0x00>;
			};

			platform {
				sound-dai = <0x201>;
			};
		};

		va-dai-link {
			link-name = "VA Capture";

			cpu {
				sound-dai = <0x202 0x6e>;
			};

			codec {
				sound-dai = <0x134 0x00>;
			};

			platform {
				sound-dai = <0x201>;
			};
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-2";
			reg = <0x00 0x00>;
			enable-method = "psci";
			power-domains = <0x02 0x03 0x00>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x04>;
			phandle = <0x18>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x04>;
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-2";
			reg = <0x00 0x100>;
			enable-method = "psci";
			power-domains = <0x05 0x03 0x00>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x04>;
			phandle = <0x19>;
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-2";
			reg = <0x00 0x200>;
			enable-method = "psci";
			power-domains = <0x06 0x03 0x00>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x04>;
			phandle = <0x1a>;
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-2";
			reg = <0x00 0x300>;
			enable-method = "psci";
			power-domains = <0x07 0x03 0x00>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x04>;
			phandle = <0x1b>;
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-2";
			reg = <0x00 0x400>;
			enable-method = "psci";
			power-domains = <0x08 0x03 0x00>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x04>;
			phandle = <0x1c>;
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-2";
			reg = <0x00 0x500>;
			enable-method = "psci";
			power-domains = <0x09 0x03 0x00>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x04>;
			phandle = <0x1d>;
		};

		cpu@10000 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x10000>;
			enable-method = "psci";
			power-domains = <0x0a 0x03 0x01>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x0b>;
			phandle = <0x1e>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x0b>;
			};
		};

		cpu@10100 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x10100>;
			enable-method = "psci";
			power-domains = <0x0c 0x03 0x01>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x0b>;
			phandle = <0x1f>;
		};

		cpu@10200 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x10200>;
			enable-method = "psci";
			power-domains = <0x0d 0x03 0x01>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x0b>;
			phandle = <0x20>;
		};

		cpu@10300 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x10300>;
			enable-method = "psci";
			power-domains = <0x0e 0x03 0x01>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x0b>;
			phandle = <0x21>;
		};

		cpu@10400 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x10400>;
			enable-method = "psci";
			power-domains = <0x0f 0x03 0x01>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x0b>;
			phandle = <0x22>;
		};

		cpu@10500 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x10500>;
			enable-method = "psci";
			power-domains = <0x10 0x03 0x01>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x0b>;
			phandle = <0x23>;
		};

		cpu@20000 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x20000>;
			enable-method = "psci";
			power-domains = <0x11 0x03 0x02>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x12>;
			phandle = <0x24>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x12>;
			};
		};

		cpu@20100 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x20100>;
			enable-method = "psci";
			power-domains = <0x13 0x03 0x02>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x12>;
			phandle = <0x25>;
		};

		cpu@20200 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x20200>;
			enable-method = "psci";
			power-domains = <0x14 0x03 0x02>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x12>;
			phandle = <0x26>;
		};

		cpu@20300 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x20300>;
			enable-method = "psci";
			power-domains = <0x15 0x03 0x02>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x12>;
			phandle = <0x27>;
		};

		cpu@20400 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x20400>;
			enable-method = "psci";
			power-domains = <0x16 0x03 0x02>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x12>;
			phandle = <0x28>;
		};

		cpu@20500 {
			device_type = "cpu";
			compatible = "qcom,oryon-2-1";
			reg = <0x00 0x20500>;
			enable-method = "psci";
			power-domains = <0x17 0x03 0x02>;
			power-domain-names = "psci", "perf";
			next-level-cache = <0x12>;
			phandle = <0x29>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x18>;
				};

				core1 {
					cpu = <0x19>;
				};

				core2 {
					cpu = <0x1a>;
				};

				core3 {
					cpu = <0x1b>;
				};

				core4 {
					cpu = <0x1c>;
				};

				core5 {
					cpu = <0x1d>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x1e>;
				};

				core1 {
					cpu = <0x1f>;
				};

				core2 {
					cpu = <0x20>;
				};

				core3 {
					cpu = <0x21>;
				};

				core4 {
					cpu = <0x22>;
				};

				core5 {
					cpu = <0x23>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x24>;
				};

				core1 {
					cpu = <0x25>;
				};

				core2 {
					cpu = <0x26>;
				};

				core3 {
					cpu = <0x27>;
				};

				core4 {
					cpu = <0x28>;
				};

				core5 {
					cpu = <0x29>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				idle-state-name = "ret";
				arm,psci-suspend-param = <0x04>;
				entry-latency-us = <0xb4>;
				exit-latency-us = <0x140>;
				min-residency-us = <0x3e8>;
				phandle = <0x32>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1000054>;
				entry-latency-us = <0x7d0>;
				exit-latency-us = <0x7d0>;
				min-residency-us = <0x2328>;
				phandle = <0x36>;
			};

			domain-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x200c354>;
				entry-latency-us = <0xaf0>;
				exit-latency-us = <0x1130>;
				min-residency-us = <0x27a6>;
				phandle = <0x37>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-glymur", "qcom,scm";
			qcom,dload-mode = <0x2a 0x4000>;
			interconnects = <0x2b 0x00 0x07 0x2c 0x01 0x07>;
		};

		scmi {
			compatible = "arm,scmi";
			mboxes = <0x2d 0x00 0x2d 0x01>;
			mbox-names = "tx", "rx";
			shmem = <0x2e 0x2f>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			protocol@13 {
				reg = <0x13>;
				#power-domain-cells = <0x01>;
				phandle = <0x03>;
			};
		};
	};

	interconnect-0 {
		compatible = "qcom,glymur-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x30>;
		phandle = <0x47>;
	};

	interconnect-1 {
		compatible = "qcom,glymur-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x30>;
		phandle = <0x2c>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x08>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x02>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x05>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x06>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x07>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x08>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x31>;
			domain-idle-states = <0x32>;
			phandle = <0x09>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x33>;
			domain-idle-states = <0x32>;
			phandle = <0x0a>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x33>;
			domain-idle-states = <0x32>;
			phandle = <0x0c>;
		};

		power-domain-cpu8 {
			#power-domain-cells = <0x00>;
			power-domains = <0x33>;
			domain-idle-states = <0x32>;
			phandle = <0x0d>;
		};

		power-domain-cpu9 {
			#power-domain-cells = <0x00>;
			power-domains = <0x33>;
			domain-idle-states = <0x32>;
			phandle = <0x0e>;
		};

		power-domain-cpu10 {
			#power-domain-cells = <0x00>;
			power-domains = <0x33>;
			domain-idle-states = <0x32>;
			phandle = <0x0f>;
		};

		power-domain-cpu11 {
			#power-domain-cells = <0x00>;
			power-domains = <0x33>;
			domain-idle-states = <0x32>;
			phandle = <0x10>;
		};

		power-domain-cpu12 {
			#power-domain-cells = <0x00>;
			power-domains = <0x34>;
			domain-idle-states = <0x32>;
			phandle = <0x11>;
		};

		power-domain-cpu13 {
			#power-domain-cells = <0x00>;
			power-domains = <0x34>;
			domain-idle-states = <0x32>;
			phandle = <0x13>;
		};

		power-domain-cpu14 {
			#power-domain-cells = <0x00>;
			power-domains = <0x34>;
			domain-idle-states = <0x32>;
			phandle = <0x14>;
		};

		power-domain-cpu15 {
			#power-domain-cells = <0x00>;
			power-domains = <0x34>;
			domain-idle-states = <0x32>;
			phandle = <0x15>;
		};

		power-domain-cpu16 {
			#power-domain-cells = <0x00>;
			power-domains = <0x34>;
			domain-idle-states = <0x32>;
			phandle = <0x16>;
		};

		power-domain-cpu17 {
			#power-domain-cells = <0x00>;
			power-domains = <0x34>;
			domain-idle-states = <0x32>;
			phandle = <0x17>;
		};

		power-domain-cpu-cluster0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x35>;
			domain-idle-states = <0x36>;
			phandle = <0x31>;
		};

		power-domain-cpu-cluster1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x35>;
			domain-idle-states = <0x36>;
			phandle = <0x33>;
		};

		power-domain-cpu-cluster2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x35>;
			domain-idle-states = <0x36>;
			phandle = <0x34>;
		};

		power-domain-system {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x37>;
			phandle = <0x35>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		pdp@81400000 {
			reg = <0x00 0x81400000 0x00 0x100000>;
			no-map;
		};

		aop-cmd-db@81c60000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x81c60000 0x00 0x20000>;
			no-map;
		};

		pdp-ns-shared@81e00000 {
			reg = <0x00 0x81e00000 0x00 0x200000>;
			no-map;
		};

		oobdaretag@86e10000 {
			reg = <0x00 0x86e10000 0x00 0x360000>;
			no-map;
		};

		oob-secure@87170000 {
			reg = <0x00 0x87170000 0x00 0xbc0000>;
			no-map;
		};

		oobdtbqc@87d30000 {
			reg = <0x00 0x87d30000 0x00 0x20000>;
			no-map;
		};

		oobdtboem@87d50000 {
			reg = <0x00 0x87d50000 0x00 0x20000>;
			no-map;
		};

		oob-nonsecure@87e00000 {
			reg = <0x00 0x87e00000 0x00 0xc00000>;
			no-map;
		};

		spss@88a00000 {
			reg = <0x00 0x88a00000 0x00 0x400000>;
			no-map;
		};

		soccpdtb@892e0000 {
			reg = <0x00 0x892e0000 0x00 0x20000>;
			no-map;
		};

		soccp@89300000 {
			reg = <0x00 0x89300000 0x00 0x400000>;
			no-map;
		};

		cvp@89700000 {
			reg = <0x00 0x89700000 0x00 0x700000>;
			no-map;
		};

		adspslpi@89e00000 {
			reg = <0x00 0x89e00000 0x00 0x3a00000>;
			no-map;
			phandle = <0x130>;
		};

		q6-adsp-dtb@8d800000 {
			reg = <0x00 0x8d800000 0x00 0x80000>;
			no-map;
			phandle = <0x131>;
		};

		cdsp@8d900000 {
			reg = <0x00 0x8d900000 0x00 0x4000000>;
			no-map;
		};

		q6-cdsp-dtb@91900000 {
			reg = <0x00 0x91900000 0x00 0x80000>;
			no-map;
		};

		gpu-microcode@919fe000 {
			reg = <0x00 0x919fe000 0x00 0x2000>;
			no-map;
		};

		camera@91a00000 {
			reg = <0x00 0x91a00000 0x00 0x800000>;
			no-map;
		};

		av1-encoder@92200000 {
			reg = <0x00 0x92200000 0x00 0x700000>;
			no-map;
		};

		video@92900000 {
			reg = <0x00 0x92900000 0x00 0xc00000>;
			no-map;
		};

		smem@ffe00000 {
			compatible = "qcom,smem";
			reg = <0x00 0xffe00000 0x00 0x200000>;
			hwlocks = <0x38 0x03>;
			no-map;
		};
	};

	smp2p-adsp {
		compatible = "qcom,smp2p";
		interrupts-extended = <0x39 0x03 0x02 0x01>;
		mboxes = <0x39 0x03 0x02>;
		qcom,smem = <0x1bb 0x1ad>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x12f>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x12e>;
		};
	};

	smp2p-cdsp {
		compatible = "qcom,smp2p";
		interrupts-extended = <0x39 0x06 0x02 0x01>;
		mboxes = <0x39 0x06 0x02>;
		qcom,smem = <0x5e 0x1b0>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	smp2p-soccp {
		compatible = "qcom,smp2p";
		interrupts-extended = <0x39 0x2e 0x02 0x01>;
		mboxes = <0x39 0x2e 0x02>;
		qcom,smem = <0x269 0x268>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x13>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0x00 0x00 0x00 0x100 0x00>;
		dma-ranges = <0x00 0x00 0x00 0x00 0x100 0x00>;

		clock-controller@100000 {
			compatible = "qcom,glymur-gcc";
