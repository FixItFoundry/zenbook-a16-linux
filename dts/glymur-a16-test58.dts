		remoteproc@6800000 {
			compatible = "qcom,glymur-adsp-pas", "qcom,sm8550-adsp-pas";
			reg = <0x00 0x6800000 0x00 0x10000>;
			iommus = <0x45 0x1000 0x00>;
			interrupts-extended = <0xd8 0x06 0x01 0x12e 0x00 0x01 0x12e 0x01 0x01 0x12e 0x02 0x01 0x12e 0x03 0x01 0x12e 0x07 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack", "shutdown-ack";
			clocks = <0x3a 0x00>;
			clock-names = "xo";
			power-domains = <0xaf 0x04 0xaf 0x05>;
			power-domain-names = "lcx", "lmx";
			memory-region = <0x130 0x131>;
			firmware-name = "qcom/glymur/ASUSTeK/UX3607OA/qcadsp8480.mbn", "qcom/glymur/ASUSTeK/UX3607OA/adsp_dtbs.elf";
			qcom,qmp = <0x12d>;
			qcom,smem-states = <0x12f 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";
			interconnects = <0x132 0x00 0x07 0x2c 0x01 0x07>;

			glink-edge {
				interrupts-extended = <0x39 0x03 0x00 0x01>;
				mboxes = <0x39 0x03 0x00>;
				qcom,remote-pid = <0x02>;
				label = "lpass";

				gpr {
					compatible = "qcom,gpr";
					qcom,glink-channels = "adsp_apps";
					qcom,domain = <0x02>;
					qcom,intents = <0x200 0x14>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					service@1 {
						compatible = "qcom,q6apm";
						phandle = <0x201>;
						reg = <0x01>;
						#sound-dai-cells = <0x00>;
						qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";

						dais {
							compatible = "qcom,q6apm-dais";
							iommus = <0x45 0x1001 0x80 0x45 0x1061 0x00>;
						};

						bedais {
							compatible = "qcom,q6apm-lpass-dais";
							#sound-dai-cells = <0x01>;
							phandle = <0x202>;
						};
					};

					service@2 {
						compatible = "qcom,q6prm";
						reg = <0x02>;
						qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";

						clock-controller {
							compatible = "qcom,q6prm-lpass-clocks";
							#clock-cells = <0x02>;
							phandle = <0x133>;
						};
					};
				};

				fastrpc {
					compatible = "qcom,glymur-fastrpc", "qcom,kaanapali-fastrpc";
					qcom,glink-channels = "fastrpcglink-apps-dsp";
					label = "adsp";
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					compute-cb@3 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x03>;
						iommus = <0x45 0x1003 0x80 0x45 0x1063 0x20>;
						dma-coherent;
					};

					compute-cb@4 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x04>;
						iommus = <0x45 0x1004 0x80 0x45 0x1064 0x20>;
						dma-coherent;
					};

					compute-cb@5 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x05>;
						iommus = <0x45 0x1005 0x80 0x45 0x1065 0x20>;
						dma-coherent;
					};

					compute-cb@6 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x06>;
						iommus = <0x45 0x1006 0x80 0x45 0x1066 0x20>;
						dma-coherent;
					};

					compute-cb@7 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x07>;
						iommus = <0x45 0x1007 0x40 0x45 0x1067 0x00 0x45 0x1087 0x00>;
						dma-coherent;
					};

					compute-cb@8 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x08>;
						iommus = <0x45 0x1008 0x80 0x45 0x1068 0x20>;
						dma-coherent;
					};
				};
			};
		};
	};

