				interrupt-controller;
				#interrupt-cells = <0x04>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				pmic@9 {
					compatible = "qcom,smb2370", "qcom,spmi-pmic";
					reg = <0x09 0x00>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					phy@fd00 {
						compatible = "qcom,smb2370-eusb2-repeater";
						reg = <0xfd00>;
						#phy-cells = <0x00>;
						vdd18-supply = <0x6b>;
