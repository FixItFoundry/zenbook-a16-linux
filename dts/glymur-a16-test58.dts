	thermal_zones {

		pmh0104-i0-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x11c>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};

		pmh0104-j0-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x11d>;

			trips {

				trip0 {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "passive";
				};

				trip1 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};

		pmh0104-l1-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x11e>;

