From a0cfc8e35aa4a10a9d6aa907fa661468d86ba38c Mon Sep 17 00:00:00 2001
From: Codex <codex@local.invalid>
Date: Tue, 13 Oct 2026 21:32:16 -0400
Subject: [PATCH 127/127] Release GPI caller ring only on failures before
 hardware commands

---
 drivers/dma/qcom/gpi.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/dma/qcom/gpi.c b/drivers/dma/qcom/gpi.c
index 46e6ffe5259a7aaeedbe9e2b3d2cf0262351af0f..e954328d71cab6f0dfa549d285997afe35b83234 100644
--- a/drivers/dma/qcom/gpi.c
+++ b/drivers/dma/qcom/gpi.c
@@ -1925,7 +1925,7 @@ static int gpi_ch_init(struct gchan *gchan)
 		dev_err(gpii->gpi_dev->dev, "protocol did not match protocol %u != %u\n",
 			gpii->gchan[0].protocol, gpii->gchan[1].protocol);
 		ret = -EINVAL;
-		goto exit_gpi_init;
+		goto error_free_ch_ring;
 	}
 
 	/* allocate memory for event ring */
@@ -1933,7 +1933,7 @@ static int gpi_ch_init(struct gchan *gchan)
 	ret = gpi_alloc_ring(&gpii->ev_ring, elements,
 			     sizeof(union gpi_event), gpii);
 	if (ret)
-		goto exit_gpi_init;
+		goto error_free_ch_ring;
 
 	/* configure interrupts */
 	write_lock_irq(&gpii->pm_lock);
@@ -1982,8 +1982,16 @@ static int gpi_ch_init(struct gchan *gchan)
 		gpi_reset_chan(&gpii->gchan[i], GPI_CH_CMD_DE_ALLOC);
 error_alloc_ev_ring:
 	gpi_disable_interrupts(gpii);
+	gpi_free_ring(&gpii->ev_ring, gpii);
+	goto exit_gpi_init;
 error_config_int:
 	gpi_free_ring(&gpii->ev_ring, gpii);
+error_free_ch_ring:
+	/* No hardware command has exposed this transfer ring. */
+	gpi_free_ring(&gchan->ch_ring, gpii);
+	write_lock_irq(&gpii->pm_lock);
+	gchan->pm_state = DISABLE_STATE;
+	write_unlock_irq(&gpii->pm_lock);
 exit_gpi_init:
 	return ret;
 }
