diff --git a/drivers/soundwire/qcom.c b/drivers/soundwire/qcom.c
index 9d39f298e08fd820f5cc7bb6381acac48ea96bdd..5f4f4fca2cb42d642fcc1acbe5d592d960d4483b 100644
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -1492,8 +1492,10 @@ static int qcom_swrm_startup(struct snd_pcm_substream *substream,
 			     struct snd_soc_dai *dai)
 {
 	struct qcom_swrm_ctrl *ctrl = dev_get_drvdata(dai->dev);
+	bool recovery_retried = false;
 	int ret;
 
+retry:
 	if (atomic_read(&ctrl->recovery_pending)) {
 		/* Startup can be called while another controller still probes. */
 		if (!mutex_trylock(&qcom_swrm_probe_recovery_lock))
@@ -1520,6 +1522,20 @@ static int qcom_swrm_startup(struct snd_pcm_substream *substream,
 		goto unlock;
 	}
 
+	/* Resume can queue clash recovery after the pre-resume check. */
+	synchronize_irq(ctrl->irq);
+	if (atomic_read(&ctrl->recovery_pending)) {
+		pm_runtime_mark_last_busy(ctrl->dev);
+		pm_runtime_put_autosuspend(ctrl->dev);
+		mutex_unlock(&ctrl->recovery_lock);
+
+		/* The worker needs recovery_lock; wait only after releasing it. */
+		if (recovery_retried)
+			return -EIO;
+		recovery_retried = true;
+		goto retry;
+	}
+
 	ctrl->active_streams++;
 	ret = 0;
 unlock:
