# Hardware additions to Arch Linux ARM linux-aarch64 7.2.10-1 config.
CONFIG_LOCALVERSION="-omarchy-a16"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_PINCTRL_GLYMUR=y
CONFIG_CLK_GLYMUR_GCC=y
CONFIG_CLK_GLYMUR_TCSRCC=y
CONFIG_CLK_GLYMUR_DISPCC=m
CONFIG_CLK_GLYMUR_GPUCC=m
CONFIG_CLK_GLYMUR_CAMCC=m
CONFIG_CLK_GLYMUR_EVACC=m
CONFIG_INTERCONNECT_QCOM_GLYMUR=y
CONFIG_HID_ASUS=m
CONFIG_EC_ASUS_GLYMUR=m
CONFIG_PHY_QCOM_QMP_PCIE_MULTIPHY=y
CONFIG_PHY_QCOM_MIPI_CSI2=m
# SoCCP shared-memory protection requires the bridge backend.
# CONFIG_QCOM_TZMEM_MODE_GENERIC is not set
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_ATH12K_DEBUGFS=y
CONFIG_ATH12K_TRACING=y
