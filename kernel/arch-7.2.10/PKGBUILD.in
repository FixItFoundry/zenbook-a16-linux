# Generated by prepare-package.py; source and patch checksums are mandatory.
# Versioned payloads remain installed when the tracking packages advance.
pkgbase=@KERNEL_PACKAGE@
pkgname=("$pkgbase" "$pkgbase-headers" linux-omarchy-a16-tracking linux-omarchy-a16-tracking-headers)
pkgver=7.2.10
pkgrel=@PKGREL@
pkgdesc='Arch Linux ARM kernel with ASUS Zenbook A16 bring-up backports'
arch=(aarch64)
url='https://github.com/FixItFoundry/zenbook-a16-linux'
license=(GPL-2.0-only)
makedepends=(bc bison flex git kmod libelf openssl pahole perl python rsync)
options=(!strip !debug !buildflags)
export SOURCE_DATE_EPOCH=1792018800
source=(
  'https://www.kernel.org/pub/linux/kernel/v7.x/linux-7.2.tar.xz'
  "https://www.kernel.org/pub/linux/kernel/v7.x/patch-${pkgver}.xz"
  'a16-backport.tar.xz'
)
noextract=("patch-${pkgver}.xz")
sha256sums=(
  '@BASE_SHA256@'
  '@STABLE_SHA256@'
  '@BUNDLE_SHA256@'
)

prepare() {
  cd "$srcdir/linux-7.2"
  # Use a private index so an enclosing source checkout cannot affect git apply.
  git init -q
  # The upstream archive includes tracked files matched by its own ignore rules.
  git add --force -A
  [[ $(git write-tree) == '@BASE_TREE@' ]] || return 1
  xz -dc "$srcdir/patch-${pkgver}.xz" > "$srcdir/stable.patch"
  git apply --index --whitespace=nowarn "$srcdir/stable.patch"
  local patch
  while IFS= read -r patch; do
    git apply --index "$srcdir/a16-backport/patches/$patch"
  done < "$srcdir/a16-backport/series"
  [[ $(git write-tree) == '@SOURCE_TREE@' ]] || return 1
  mkdir -p "$srcdir/build"
  scripts/kconfig/merge_config.sh -m -O "$srcdir/build" \
    "$srcdir/a16-backport/config" "$srcdir/a16-backport/a16.config"
  make O="$srcdir/build" ARCH=arm64 LOCALVERSION="-$pkgrel" olddefconfig
}

build() {
  unset LDFLAGS
  export KBUILD_BUILD_USER=omarchy-a16 KBUILD_BUILD_HOST=archlinuxarm
  export KBUILD_BUILD_VERSION=1
  export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@$SOURCE_DATE_EPOCH" '+%Y-%m-%d %H:%M:%S UTC')"
  cd "$srcdir/linux-7.2"
  make O="$srcdir/build" ARCH=arm64 LOCALVERSION="-$pkgrel" Image modules
  make O="$srcdir/build" ARCH=arm64 LOCALVERSION="-$pkgrel" DTC_FLAGS=-@ dtbs
}

check() {
  cd "$srcdir/linux-7.2"
  local release
  release=$(make -s O="$srcdir/build" ARCH=arm64 LOCALVERSION="-$pkgrel" kernelrelease)
  [[ $release == "$pkgver-omarchy-a16-$pkgrel" ]] || return 1
  [[ -s $srcdir/build/arch/arm64/boot/Image ]] || return 1
  [[ -s $srcdir/build/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb ]] || return 1
  local dt_source
  dt_source=$("$srcdir/build/scripts/dtc/dtc" -I dtb -O dts \
    "$srcdir/build/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb" 2>/dev/null) || return 1
  [[ $(grep -c 'qcom,keep-runtime-active;' <<< "$dt_source") == 2 ]] || return 1
  python - "$srcdir/a16-backport/a16.config" "$srcdir/build/.config" <<'PY'
from pathlib import Path
import sys
expected = {s for s in Path(sys.argv[1]).read_text().splitlines()
            if s.startswith('CONFIG_') or s.startswith('# CONFIG_')}
actual = set(Path(sys.argv[2]).read_text().splitlines())
missing = expected - actual
if missing:
    raise SystemExit('Required configuration missing: ' + ', '.join(sorted(missing)))
PY
  python "$srcdir/a16-backport/test_package.py"
}

package_@KERNEL_PACKAGE@() {
  depends=(coreutils initramfs kmod)
  optdepends=('linux-firmware-qcom: Qualcomm firmware' 'wireless-regdb: wireless regulatory data'
              'systemd-ukify: build the explicit versioned A16 UKI preset')
  provides=(WIREGUARD-MODULE)
  cd "$srcdir/linux-7.2"
  local release modules
  release=$(make -s O="$srcdir/build" ARCH=arm64 LOCALVERSION="-$pkgrel" kernelrelease)
  modules="$pkgdir/usr/lib/modules/$release"
  make O="$srcdir/build" ARCH=arm64 LOCALVERSION="-$pkgrel" \
    INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 DEPMOD=true modules_install
  rm -f "$modules/build"
  install -m644 "$srcdir/build/arch/arm64/boot/Image" "$modules/vmlinuz"
  printf '%s\n' "$pkgbase" > "$modules/pkgbase"
  make O="$srcdir/build" ARCH=arm64 LOCALVERSION="-$pkgrel" \
    INSTALL_DTBS_PATH="$pkgdir/boot/dtbs/$pkgbase" dtbs_install
  install -Dm644 /dev/stdin "$modules/uki.conf" <<UKI_CONFIG
[UKI]
DeviceTreeAuto=/boot/dtbs/$pkgbase/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb
UKI_CONFIG
  install -Dm644 /dev/stdin "$pkgdir/etc/mkinitcpio.d/$pkgbase.preset" <<'UKI_PRESET'
# Explicit standalone build only; Limine's automatic hook bypasses presets.
a16_uki_prefix=$(cat /etc/machine-id)
for a16_uki_config in /usr/share/limine-entry-tool.d/*.conf /etc/limine-entry-tool.conf \
  /etc/limine-entry-tool.d/*.conf /etc/default/limine; do
  [[ ! -f $a16_uki_config ]] || source "$a16_uki_config"
done
if [[ ${CUSTOM_UKI_NAME:-} =~ ^[a-z0-9]+$ ]]; then
  a16_uki_prefix=$CUSTOM_UKI_NAME
fi
ALL_kver='@KERNEL_RELEASE@'
PRESETS=('default')
default_uki="/boot/EFI/Linux/${a16_uki_prefix}_@KERNEL_PACKAGE@.efi"
default_options='--ukiconfig /usr/lib/modules/@KERNEL_RELEASE@/uki.conf'
unset a16_uki_prefix a16_uki_config
UKI_PRESET
  depmod -b "$pkgdir/usr" "$release"
  install -Dm644 "$srcdir/a16-backport/build.json" \
    "$pkgdir/usr/share/doc/$pkgbase/source-build.json"
  install -Dm644 "$srcdir/build/.config" "$pkgdir/usr/share/doc/$pkgbase/config"
  printf '%s\n' "$release" > "$pkgdir/usr/share/doc/$pkgbase/kernel-release"
  # This records the legacy standalone contract, never the shared kernel's ABI 1.
  python - "$modules" "$pkgdir/boot/dtbs/$pkgbase/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb" \
    "$srcdir/a16-backport/build.json" "$srcdir/build/.config" "$pkgbase" <<'PY_METADATA'
import hashlib
import json
from pathlib import Path
import sys
modules, dtb, source, config = map(Path, sys.argv[1:5])
provenance = json.loads(source.read_text())
metadata = {
    "schema": 1, "kernel_release": modules.name, "kernel_package": sys.argv[5],
    "kernel_sha256": hashlib.sha256((modules / "vmlinuz").read_bytes()).hexdigest(),
    "dtb_sha256": hashlib.sha256(dtb.read_bytes()).hexdigest(),
    "config_sha256": hashlib.sha256(config.read_bytes()).hexdigest(),
    "source_tree": provenance["source_tree"], "source_status": provenance["status"],
    "dsp_policy": "omarchy-a16-legacy-v1", "cmdline": [],
}
(modules / "zenbook-a16-boot.json").write_text(json.dumps(metadata, indent=2) + "\n")
PY_METADATA
  ${CC:-gcc} --version > "$pkgdir/usr/share/doc/$pkgbase/compiler.txt"
  (cd "$pkgdir" && sha256sum "usr/share/doc/$pkgbase/config" \
    "usr/lib/modules/$release/vmlinuz" \
    "boot/dtbs/$pkgbase/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb" \
    "usr/lib/modules/$release/zenbook-a16-boot.json") \
    > "$pkgdir/usr/share/doc/$pkgbase/build-artifacts.SHA256SUMS"
}

package_@KERNEL_PACKAGE@-headers() {
  pkgdesc='Headers for the Arch-based ASUS Zenbook A16 kernel'
  depends=(glibc binutils libelf libgcc openssl pahole xxhash zlib zstd)
  cd "$srcdir/linux-7.2"
  local release headers
  release=$(make -s O="$srcdir/build" ARCH=arm64 LOCALVERSION="-$pkgrel" kernelrelease)
  headers="$pkgdir/usr/lib/modules/$release/build"
  make O="$srcdir/build" ARCH=arm64 LOCALVERSION="-$pkgrel" run-command \
    KBUILD_RUN_COMMAND="\$(srctree)/scripts/package/install-extmod-build $headers"
  install -m644 "$srcdir/build/.config" "$srcdir/build/System.map" "$headers/"
  install -d "$pkgdir/usr/src"
  ln -s "../lib/modules/$release/build" "$pkgdir/usr/src/$pkgbase"
}

package_linux-omarchy-a16-tracking() {
  pkgdesc='Track the versioned standalone A16 development kernel'
  depends=("$pkgbase=$pkgver-$pkgrel")
}

package_linux-omarchy-a16-tracking-headers() {
  pkgdesc='Track the matching standalone A16 development kernel headers'
  depends=("$pkgbase-headers=$pkgver-$pkgrel")
}
