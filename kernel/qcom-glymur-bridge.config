# Qualcomm Glymur ("Snapdragon X2 Series") Early Developer Preview Bridge Fragment
# Derived from Qualcomm-linux/kernel-config (qcom-next.conf),
# Qualcomm-linux/qcom-deb-images (qcom-laptops.config), and qcom-topics/* (2026-10-18).

# 1. Glymur LPASS Clock Controller & Reset Lines (qcom-topics/tech/mm/audio/all)
CONFIG_CLK_GLYMUR_LPASSCC=m

# 2. Audio / SoundWire / WCD9378 & SDCA Codecs
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_X1E80100=m
CONFIG_SND_SOC_LPASS_WSA_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_WSA884X=m
CONFIG_SND_SOC_WCD9378_SDW=m
CONFIG_SND_SOC_WCD937X_SDW=m
CONFIG_SND_SOC_SDCA=m
CONFIG_SND_SOC_SDCA_HID=m
CONFIG_SND_SOC_SDCA_IRQ=m
CONFIG_SND_SOC_SDCA_FDL=m

# 3. PMIC GLINK RTC (replaces disabled UEFI RTC on Glymur laptops)
CONFIG_RTC_DRV_QCOM_GLINK=m

# 4. QTEE EFI Variable Service & Qualcomm fTPM (qcom-topics/tech/security/firmware-smc)
CONFIG_QCOM_TEE=m
CONFIG_QCOM_TEE_UEFISECAPP=m
CONFIG_TCG_QCOM=m

# 5. PCIe M.2 & WCN Power Sequencing (required for QCC2072 Wi-Fi / BT on 7.3+ / linux-next)
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_POWER_SEQUENCING_PCIE_M2=m

# 6. Standalone MIPI CSI-2 D-PHY & CAMSS (linux-next / qcom-topics/tech/mm/camss)
CONFIG_PHY_QCOM_MIPI_CSI2=m
CONFIG_VIDEO_QCOM_CAMSS=m

# 7. Glymur Video Decoder/Encoder (Iris on CDSP non-SCM PAS backend)
CONFIG_VIDEO_QCOM_IRIS=m

# 8. Glymur SCMI Memlat & SPEL Power Limits (qcom-next.conf)
CONFIG_ARM_QCOM_SCMI_MEMLAT=m
CONFIG_QCOM_SPEL=m
