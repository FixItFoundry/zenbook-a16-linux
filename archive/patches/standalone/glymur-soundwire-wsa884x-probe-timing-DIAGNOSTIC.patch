+	trace_printk("wsa884x %s: calling regulator_bulk_enable\n", dev_name(dev));
 	ret = regulator_bulk_enable(WSA884X_SUPPLIES_NUM, wsa884x->supplies);
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to enable regulators\n");
+	trace_printk("wsa884x %s: regulators enabled\n", dev_name(dev));

 	ret = devm_add_action_or_reset(dev, wsa884x_regulator_disable,
 				       wsa884x->supplies);
@@ -2070,8 +2088,12 @@ static int wsa884x_probe(struct sdw_slave *pdev,
 		return ret;

 	ret = wsa884x_get_reset(dev, wsa884x);
-	if (ret)
+	if (ret) {
+		trace_printk("wsa884x %s: wsa884x_get_reset returned %d, probe bailing out\n",
