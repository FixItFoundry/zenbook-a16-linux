+	trace_printk("wsa884x %s: wsa884x_get_reset returned 0\n", dev_name(dev));

 	dev_set_drvdata(dev, wsa884x);
 	wsa884x->slave = pdev;
@@ -2096,6 +2118,7 @@ static int wsa884x_probe(struct sdw_slave *pdev,
 	pdev->prop.scp_int1_mask = SDW_SCP_INT1_BUS_CLASH | SDW_SCP_INT1_PARITY;

 	wsa884x_reset_deassert(wsa884x);
+	trace_printk("wsa884x %s: reset deasserted\n", dev_name(dev));
 	ret = devm_add_action_or_reset(dev, wsa884x_reset_powerdown, wsa884x);
 	if (ret)
 		return ret;
