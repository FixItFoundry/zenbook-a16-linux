diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 9b447a8b9..047e3509d 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -188,6 +188,19 @@ static int msm_dp_aux_link_configure(struct drm_dp_aux *aux,
 		return err;
 
 	if (link->use_rate_set) {
+		/*
+		 * Per eDP 1.4b, LINK_RATE_SET is only consulted while
+		 * LINK_BW_SET reads 00h, so the legacy selector has to be
+		 * cleared before the rate-set one is written. Drivers that
+		 * never touch LINK_BW_SET get this for free; we cannot assume
+		 * it, because firmware may have trained the panel and left its
+		 * own selection behind (on the ASUS Zenbook A16 the UEFI
+		 * leaves DP_LINK_BW_5_4 there).
+		 */
+		err = drm_dp_dpcd_writeb(aux, DP_LINK_BW_SET, 0);
+		if (err < 0)
+			return err;
+
 		DRM_DEBUG_DP("using LINK_RATE_SET: 0x%02x", link->rate_set);
 		err = drm_dp_dpcd_writeb(aux, DP_LINK_RATE_SET, link->rate_set);
 	} else {
@@ -1632,6 +1645,8 @@ static int msm_dp_ctrl_link_train(struct msm_dp_ctrl_private *ctrl,
 
 	link_info.num_lanes = ctrl->link->link_params.num_lanes;
 	link_info.rate = ctrl->link->link_params.rate;
+	link_info.rate_set = ctrl->link->link_params.rate_set;
+	link_info.use_rate_set = ctrl->link->link_params.use_rate_set;
 	link_info.capabilities = DP_LINK_CAP_ENHANCED_FRAMING;
 
 	msm_dp_aux_link_configure(ctrl->aux, &link_info);
@@ -2299,6 +2314,20 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl)
 		ctrl->link->link_params.rate = rate;
 		ctrl->link->link_params.num_lanes =
 			ctrl->panel->link_info.num_lanes;
+		/*
+		 * The eDP 1.4 rate-set selection is computed into
+		 * panel->link_info, but every consumer reads link->link_params
+		 * -- without this copy use_rate_set can never be seen by
+		 * msm_dp_aux_link_configure(), and rate_set is always 0 in
+		 * msm_dp_ctrl_link_rate_down_shift().
+		 */
+		ctrl->link->link_params.rate_set =
+			ctrl->panel->link_info.rate_set;
+		ctrl->link->link_params.use_rate_set =
+			ctrl->panel->link_info.use_rate_set;
+		memcpy(ctrl->link->link_params.supported_rates,
+		       ctrl->panel->link_info.supported_rates,
+		       sizeof(ctrl->link->link_params.supported_rates));
 		if (ctrl->panel->msm_dp_mode.out_fmt_is_yuv_420)
 			pixel_rate >>= 1;
 	}
diff --git a/drivers/gpu/drm/msm/dp/dp_panel.c b/drivers/gpu/drm/msm/dp/dp_panel.c
index 891211b23..3ecce86dc 100644
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -171,6 +171,46 @@ static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
 			/* Only use LINK_RATE_SET if LINK_BW_SET hasn't already been written to */
 			if (!bw_set && link_info->rate)
 				link_info->use_rate_set = true;
+
+			/*
+			 * HACK (glymur): force HBR3 via the legacy LINK_BW_SET
+			 * path, overriding the rate selection above.
+			 *
+			 * This is empirical and we have no explanation for it.
+			 * The panel -- a Samsung ATNA60HR07-0, eDP 1.5 -- reports
+			 * a maximum of 5.4G everywhere it is asked: its
+			 * SUPPORTED_LINK_RATES table tops out at 540000, and its
+			 * EXTENDED receiver cap block (DPCD 0x2200, taken because
+			 * 0x00e bit7 is set) reports MAX_LINK_RATE = 0x14 =
+			 * DP_LINK_BW_5_4. The UEFI leaves 0x14 in LINK_BW_SET,
+			 * i.e. the firmware selects 5.4G too. Yet 5.4G never
+			 * completes channel equalisation for us, and 8.1G -- a
+			 * rate the sink does not advertise at all -- trains first
+			 * try, on all four lanes, with the stock drive levels.
+			 *
+			 * 5.4G was eliminated exhaustively before resorting to
+			 * this: EQ fails byte-identically at 4, 2 and 1 lanes, at
+			 * every drive level the sink asks for, with the drive
+			 * writes verified to land in the TX blocks, and via both
+			 * the LINK_BW_SET and LINK_RATE_SET selectors. 2.7G and
+			 * 1.62G are dead below this layer -- the PHY never reaches
+			 * C_READY on the v8 PLL constants for those rates.
+			 *
+			 * Between 5.4G and 8.1G, exactly one register differs in
+			 * the whole PHY programming sequence: DP_PHY_VCO_DIV, 0x02
+			 * vs 0x01 (edp_phy_vco_div_cfg_v8[2] vs [3]). Both rates
+			 * share one entry in qcom_edp_com_configure_pll_v8() and
+			 * both land on the same 1.35GHz divided VCO. That makes
+			 * the v8 5400 VCO divider the prime suspect for the real
+			 * bug, and this force a workaround for it, not a fix.
+			 *
+			 * rate_set = 0 keeps msm_dp_ctrl_link_rate_down_shift() on
+			 * its legacy switch, so a train_1 failure falls back
+			 * 810000 -> 540000 rather than into the broken low rates.
+			 */
+			link_info->rate = 810000;
+			link_info->rate_set = 0;
+			link_info->use_rate_set = false;
 		}
 	}
 
diff --git a/drivers/hid/hid-asus.c b/drivers/hid/hid-asus.c
index 3f5e96900..bb1f6fb74 100644
--- a/drivers/hid/hid-asus.c
