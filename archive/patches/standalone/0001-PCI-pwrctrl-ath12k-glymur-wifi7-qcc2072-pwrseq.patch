From: FixItFoundry <jesse.casco@gmail.com>
Subject: [PATCH] PCI: pwrctrl / ath12k / DTS: add QCC2072 Wi-Fi 7 power sequencing, OF devlink cycle fix, and NAPI storm guard

Fixes cold boot Wi-Fi enumeration failure, fw_devlink probe deferral cycle,
and softirq NAPI loop crash on ASUS Zenbook A16 (UX3607OA, Glymur X2 Elite):

1. drivers/pci/pwrctrl/pci-pwrctrl-pwrseq.c:
   - Add QCC2072 ("pci17cb,1112") to pwrseq_pwrctrl_of_match[] so that
     pci-pwrctrl-pwrseq binds to the wifi@0 PCI device node.
2. drivers/pci/pwrctrl/Kconfig:
   - Add user-visible prompt to PCI_PWRCTRL_PWRSEQ so CONFIG_PCI_PWRCTRL_PWRSEQ
     can be selected as built-in (=y) alongside CONFIG_POWER_SEQUENCING_QCOM_WCN=y.
     Because pcie-qcom is built-in (=y), having pwrseq drivers as modules causes
     PCIe link training to fail during early boot before modules load, leaving
     the WLAN chip un-enumerated.
3. drivers/net/wireless/ath/ath12k/pci.c:
   - In ath12k_pci_ext_grp_napi_poll(), guard enable_irq() with
     if (napi_complete_done(napi, work_done)). Calling enable_irq()
     unconditionally when napi_complete_done() fails triggers an immediate
     re-interrupt loop in softirq context, causing NOHZ tick-stop errors
     and system hang.
4. arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts:
   - Wire wifi@0 under pcie4_port0 with PMU regulator supplies
     (vddaon, vddwlcx, vddwlmx, vddrfacmn, vddrfa*, vddpcie*).
   - Remove redundant wlan-connector node and uart14 graph endpoint which
     created a circular dependency in fw_devlink between PCIe and UART.
---
 arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts | 48 ++++++++++-----------------------
 drivers/net/wireless/ath/ath12k/pci.c                         |  7 +++--
 drivers/pci/pwrctrl/Kconfig                                   |  2 +-
 drivers/pci/pwrctrl/pci-pwrctrl-pwrseq.c                      |  5 ++++
 4 files changed, 25 insertions(+), 37 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
index a6ca2dd663c8..d43fe26f7532 100644
--- a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
@@ -458,41 +458,6 @@ sound {
 		};
 	};
 
-	wlan-connector {
-		compatible = "pcie-m2-e-connector";
-		vpcie3v3-supply = <&vreg_wcn_3p3>;
-		vpcie1v8-supply = <&vreg_l15b_e0>;
-
-		/*
-		 * GLYMUR-A16: pin/gpio ownership (tlmm 116/117, wcn_wlan_bt_en)
-		 * moved to wcn7850-pmu; this node is kept only as the PCIe/UART
-		 * graph anchor so the endpoint labels resolve.
-		 */
-		ports {
-			#address-cells = <1>;
-			#size-cells = <0>;
-
-			port@0 {
-				reg = <0>;
-				#address-cells = <1>;
-				#size-cells = <0>;
-
-				m2_e_pcie_ep: endpoint@0 {
-					reg = <0>;
-					remote-endpoint = <&pcie4_port0_ep>;
-				};
-			};
-
-			port@3 {
-				reg = <3>;
-				#address-cells = <1>;
-				#size-cells = <0>;
-
-				m2_e_uart_ep: endpoint@0 {
-					reg = <0>;
-					remote-endpoint = <&uart14_ep>;
-				};
-			};
-		};
-	};
 };
 
 &apps_rsc {
@@ -970,8 +935,21 @@ &pcie4_phy {
 &pcie4_port0 {
 	reset-gpios = <&tlmm 146 GPIO_ACTIVE_LOW>;
 	wake-gpios = <&tlmm 148 GPIO_ACTIVE_LOW>;
-};
-
-&pcie4_port0_ep {
-	remote-endpoint = <&m2_e_pcie_ep>;
+
+	wifi@0 {
+		compatible = "pci17cb,1112";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+	};
 };
 
 &pcie5 {
@@ -1373,11 +1351,6 @@ bluetooth {
 		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
 	};
 
-	port {
-		uart14_ep: endpoint {
-			remote-endpoint = <&m2_e_uart_ep>;
-		};
-	};
 };
 
 &uart21 {
diff --git a/drivers/net/wireless/ath/ath12k/pci.c b/drivers/net/wireless/ath/ath12k/pci.c
index 6441927b5382..ea7571e88086 100644
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -504,9 +504,10 @@ static int ath12k_pci_ext_grp_napi_poll(struct napi_struct *napi, int budget)
 
 	work_done = ath12k_dp_service_srng(dp, irq_grp, budget);
 	if (work_done < budget) {
-		napi_complete_done(napi, work_done);
-		for (i = 0; i < irq_grp->num_irq; i++)
-			enable_irq(irq_grp->ab->irq_num[irq_grp->irqs[i]]);
+		if (napi_complete_done(napi, work_done)) {
+			for (i = 0; i < irq_grp->num_irq; i++)
+				enable_irq(irq_grp->ab->irq_num[irq_grp->irqs[i]]);
+		}
 	}
 
 	if (work_done > budget)
diff --git a/drivers/pci/pwrctrl/Kconfig b/drivers/pci/pwrctrl/Kconfig
index 9eec767cda86..b24b60d3c482 100644
--- a/drivers/pci/pwrctrl/Kconfig
+++ b/drivers/pci/pwrctrl/Kconfig
@@ -7,7 +7,7 @@ config PCI_PWRCTRL
 	tristate
 
 config PCI_PWRCTRL_PWRSEQ
-	tristate
+	tristate "PCI Power Control driver for power sequenced devices"
 	select POWER_SEQUENCING
 	select PCI_PWRCTRL
 
diff --git a/drivers/pci/pwrctrl/pci-pwrctrl-pwrseq.c b/drivers/pci/pwrctrl/pci-pwrctrl-pwrseq.c
index a308bf4b5fc0..90bca55ec000 100644
--- a/drivers/pci/pwrctrl/pci-pwrctrl-pwrseq.c
+++ b/drivers/pci/pwrctrl/pci-pwrctrl-pwrseq.c
@@ -122,6 +122,11 @@ static const struct of_device_id pwrseq_pwrctrl_of_match[] = {
 		.compatible = "pci17cb,1107",
 		.data = &pwrseq_pwrctrl_qcom_wcn_pdata,
 	},
+	{
+		/* ATH12K in QCC2072 package. */
+		.compatible = "pci17cb,1112",
+		.data = &pwrseq_pwrctrl_qcom_wcn_pdata,
+	},
 	{ }
 };
 MODULE_DEVICE_TABLE(of, pwrseq_pwrctrl_of_match);
-- 
