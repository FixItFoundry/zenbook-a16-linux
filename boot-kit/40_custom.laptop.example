#!/bin/sh
exec tail -n +3 $0

# Load-bearing: without insmod fdt, every devicetree line fails silently.
insmod part_gpt
insmod ext2
insmod btrfs
insmod fat
insmod fdt

# ==============================================================================
# 1. LINUX RC4 INTEGRATION (Active development candidate)
# Base: Linux v7.3-rc4 + promoted EC v3, camera LDOs, and board integration
# Retires out-of-tree DP PUSH_IDLE guard (now in mainline 7.3)
# ==============================================================================
menuentry "Fedora Linux - v7.3-rc4 Integration (7.3.0-rc4-ZenbookA16-rc4-integrated1+)" --id zenbook-a16-rc4 {
    search --set=root --fs-uuid <YOUR-ROOT-UUID>
    devicetree /boot/glymur/7.3.0-rc4-ZenbookA16-rc4-integrated1+.dtb
    linux /boot/vmlinuz-7.3.0-rc4-ZenbookA16-rc4-integrated1+ root=UUID=<YOUR-ROOT-UUID> rw clk_ignore_unused pd_ignore_unused cma=128M glymur_pci_skip=5 console=tty0 ignore_loglevel rd.timeout=60 panic=10 systemd.mask=dev-tpm0.device systemd.mask=dev-tpmrm0.device selinux=0
    initrd /boot/initrd.img-7.3.0-rc4-ZenbookA16-rc4-integrated1+
}

# ==============================================================================
# 2. STABLE WORKING BASELINE (Proven daily driver & fallback)
# Base: Linux v7.3-rc3 + 24-patch RC3 promoted integration stack
# ==============================================================================
menuentry "Fedora Linux - RC3 Stable Baseline (7.3.0-rc3-ZenbookA16-20260919-rc3-integrated1+)" --id zenbook-a16-stable {
    search --set=root --fs-uuid <YOUR-ROOT-UUID>
    devicetree /boot/glymur/7.3.0-rc3-ZenbookA16-20260919-rc3-integrated1+.dtb
    linux /boot/vmlinuz-7.3.0-rc3-ZenbookA16-20260919-rc3-integrated1+ root=UUID=<YOUR-ROOT-UUID> rw clk_ignore_unused pd_ignore_unused cma=128M glymur_pci_skip=5 console=tty0 ignore_loglevel rd.timeout=60 panic=10 systemd.mask=dev-tpm0.device systemd.mask=dev-tpmrm0.device selinux=0
    initrd /boot/initrd.img-7.3.0-rc3-ZenbookA16-20260919-rc3-integrated1+
}

# ==============================================================================
# 3. WINDOWS BOOT MANAGER
# ==============================================================================
menuentry "Windows Boot Manager" --id windows-boot {
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root <YOUR-EFI-UUID>
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}

# ==============================================================================
# 4. UEFI FIRMWARE SETTINGS
# ==============================================================================
menuentry "UEFI Firmware Settings" --id uefi-firmware {
    fwsetup
}

# ==============================================================================
# 5. DIAGNOSTIC & TEST KERNELS (Submenu)
# ==============================================================================
submenu "Diagnostic & Test Kernels" --id test-kernels {
    menuentry "Zenbook A16 EC v3 + USB Diagnostic (7.3.0-rc3-ZenbookA16-20260923-usbdiag2ecv3hid1+)" --id zenbook-a16-ecv3hid-test {
        search --set=root --fs-uuid <YOUR-ROOT-UUID>
        devicetree /boot/glymur/7.3.0-rc3-ZenbookA16-20260923-usbdiag2ecv3hid1+.dtb
        linux /boot/vmlinuz-7.3.0-rc3-ZenbookA16-20260923-usbdiag2ecv3hid1+ root=UUID=<YOUR-ROOT-UUID> rw clk_ignore_unused pd_ignore_unused cma=128M glymur_pci_skip=5 console=tty0 ignore_loglevel rd.timeout=60 panic=10 systemd.mask=dev-tpm0.device systemd.mask=dev-tpmrm0.device selinux=0
        initrd /boot/initrd.img-7.3.0-rc3-ZenbookA16-20260923-usbdiag2ecv3hid1+
    }

    menuentry "Zenbook A16 Camera Test (OV02C10 on cci1_i2c0, PMH0104 LDOs enabled)" --id zenbook-a16-camera-test {
        search --set=root --fs-uuid <YOUR-ROOT-UUID>
        devicetree /boot/glymur/7.3.0-rc4-ZenbookA16-ov02c10-camera.dtb
        linux /boot/vmlinuz-7.3.0-rc4-ZenbookA16-rc4-integrated1+ root=UUID=<YOUR-ROOT-UUID> rw clk_ignore_unused pd_ignore_unused cma=128M glymur_pci_skip=5 console=tty0 ignore_loglevel rd.timeout=60 panic=10 systemd.mask=dev-tpm0.device systemd.mask=dev-tpmrm0.device selinux=0
        initrd /boot/initrd.img-7.3.0-rc4-ZenbookA16-rc4-integrated1+
    }

    menuentry "Zenbook A16 Recovery Fallback (SELinux Permissive)" --id zenbook-a16-recovery {
        search --set=root --fs-uuid <YOUR-ROOT-UUID>
        devicetree /boot/glymur/7.3.0-rc3-ZenbookA16-20260919-rc3-integrated1+.dtb
        linux /boot/vmlinuz-7.3.0-rc3-ZenbookA16-20260919-rc3-integrated1+ root=UUID=<YOUR-ROOT-UUID> rw clk_ignore_unused pd_ignore_unused cma=128M glymur_pci_skip=5 console=tty0 ignore_loglevel rd.timeout=60 panic=10 systemd.mask=dev-tpm0.device systemd.mask=dev-tpmrm0.device enforcing=0
        initrd /boot/initrd.img-7.3.0-rc3-ZenbookA16-20260919-rc3-integrated1+
    }
}
