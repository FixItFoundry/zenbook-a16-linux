        linux /boot/vmlinuz-7.2.0-rc7-ZenbookA16-20260814 root=UUID=1ab384f7-277a-4028-9c93-5da4faee4923 rw clk_ignore_unused pd_ignore_unused cma=128M glymur_pci_skip=5 console=tty0 ignore_loglevel rd.timeout=60 panic=10 systemd.mask=dev-tpm0.device systemd.mask=dev-tpmrm0.device selinux=0
