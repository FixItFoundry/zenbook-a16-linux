#!/bin/sh
exec tail -n +3 $0

# Load-bearing: without insmod fdt, every devicetree line fails silently.
insmod part_gpt
insmod ext2
insmod btrfs
insmod fat
insmod fdt

# ===== Current Baseline (Default) =====
menuentry "Fedora on ARM (7.2.0-rc6-ZenbookA16-20260807)" --id zenbook-a16 {
    search --set=root --fs-uuid 1ab384f7-277a-4028-9c93-5da4faee4923
    devicetree /boot/glymur/7.2.0-rc6-ZenbookA16-20260807.dtb
    linux /boot/vmlinuz-7.2.0-rc6-ZenbookA16-20260807 root=UUID=1ab384f7-277a-4028-9c93-5da4faee4923 rw clk_ignore_unused pd_ignore_unused cma=128M glymur_pci_skip=5 console=tty0 ignore_loglevel rd.timeout=60 panic=10 systemd.mask=dev-tpm0.device systemd.mask=dev-tpmrm0.device selinux=0
    initrd /boot/initrd.img-7.2.0-rc6-ZenbookA16-20260807
}

# ===== Windows Boot Manager =====
menuentry "Windows Boot Manager" --id windows-boot {
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root 18B5-9082
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}

# ===== UEFI Firmware Settings =====
menuentry "UEFI Firmware Settings" --id uefi-firmware {
    fwsetup
}

# ===== Test DTBs & Fallbacks =====
submenu "Test DTBs" --id test-dtbs {
    menuentry "Zenbook A16 Test (7.2.0-rc7-ZenbookA16-20260814)" --id zenbook-a16-rc7-test {
