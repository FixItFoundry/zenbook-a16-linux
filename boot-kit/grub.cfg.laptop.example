menuentry "Fedora Linux on ARM (phase: skip noirq device callbacks)" --id fedora-linux-arm-phase2 {
    search --set=root --fs-uuid 7db7b00f-3862-4771-afee-ece1682d2970
    devicetree /boot/glymur/glymur-a16-merged-gpu-pstore.dtb
    linux /boot/vmlinuz-7.2.0-rc3-konrad1-pmskip3 root=UUID=7db7b00f-3862-4771-afee-ece1682d2970 rw clk_ignore_unused pd_ignore_unused cma=128M arm64.nopauth console=tty0 ignore_loglevel rd.timeout=60 panic=10 softlockup_panic=1 kvm-arm.mode=protected systemd.mask=dev-tpm0.device systemd.mask=dev-tpmrm0.device glymur_pm_skip=2
