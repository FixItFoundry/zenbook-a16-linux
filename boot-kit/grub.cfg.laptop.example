# ---------------------------------------------------------------------------
# Thermal cooling-maps test (2026-07-31). Byte-for-byte the baseline entry;
# ONLY the devicetree line differs.
#   glymur-a16-merged-gpu-coolmaps.dtb = the baseline scmipoll DTB plus a
#   "passive" trip at 95 C and a cooling-map on all 41 cpu/cpullc thermal
#   zones, binding each cluster to its cpufreq cooling device:
#     cpu-0-*/cpullc-0-*  -> &cpu0   (policy0,  cpufreq-cpu0)
#     cpu-1-*/cpullc-1-*  -> &cpu6   (policy6,  cpufreq-cpu6)
#     cpu-2-*/cpullc-2-*  -> &cpu12  (policy12, cpufreq-cpu12)
#   Critical stays at 115 C. polling-delay-passive = 100 ms.
#   PASS looks like: cdev bindings appear on the cpu zones, i.e.
#     for f in /sys/class/thermal/thermal_zone*/cdev*_type; do cat $f; done \
#       | grep -c cpufreq     ->  non-zero (was 0)
# ---------------------------------------------------------------------------
menuentry "Thermal cooling-maps test" --id thermal-coolmaps-test {
    search --set=root --fs-uuid 7db7b00f-3862-4771-afee-ece1682d2970
    devicetree /boot/glymur/glymur-a16-merged-gpu-coolmaps.dtb
    linux /boot/vmlinuz-7.2.0-rc3-konrad1-pmskip6 root=UUID=7db7b00f-3862-4771-afee-ece1682d2970 rw clk_ignore_unused pd_ignore_unused cma=128M arm64.nopauth console=tty0 ignore_loglevel rd.timeout=60 panic=10 softlockup_panic=1 kvm-arm.mode=protected systemd.mask=dev-tpm0.device systemd.mask=dev-tpmrm0.device glymur_pci_skip=5
    initrd /boot/initrd.img-7.2.0-rc3-konrad1
}
