#!/bin/bash
# mkinitcpio build hook: only activated by the installed A16 profile.
build() {
  case "$KERNELVERSION" in
    7.2.10-omarchy-a16-*) ;;
    *) error 'The A16 early-DSP profile requires its audited kernel'; return 1 ;;
  esac
  local firmware directory suffix found module
  for firmware in \
    qcom/glymur/ASUSTeK/UX3607OA/qcadsp8480.mbn \
    qcom/glymur/ASUSTeK/UX3607OA/adsp_dtbs.elf \
    qcom/glymur/ASUSTeK/UX3607OA/qccdsp8480.mbn \
    qcom/glymur/ASUSTeK/UX3607OA/cdsp_dtbs.elf \
    qcom/glymur/GLYMUR-ASUS-Zenbook-A16-UX3607OA-tplg.bin; do
    found=0
    for suffix in '' .zst .xz; do
      for directory in /usr/lib/firmware/updates /usr/lib/firmware; do
        if [[ -s $directory/$firmware$suffix ]]; then
          add_file "$directory/$firmware$suffix" || return 1
          found=1
          break 2
        fi
      done
    done
    if (( ! found )); then
      error "Missing required A16 early firmware: $firmware"
      return 1
    fi
  done
  # The kernel's Glymur PD mapper supplies the service map; no untracked JSON
  # copied from another laptop is needed. add_module includes dependencies.
  for module in qcom_q6v5_pas qcom_pd_mapper qcom_battmgr \
    snd_soc_x1e80100 snd_soc_wsa884x soundwire_qcom \
    pinctrl_sm8550_lpass_lpi snd_soc_lpass_wsa_macro snd_soc_lpass_va_macro; do
    add_module "$module" || return 1
  done
  # Block udev's automatic load until run_hook has checked the machine and
  # rescue flag. Explicit modprobe in that hook does not use --use-blacklist.
  add_file /usr/share/omarchy-a16/remoteproc-blacklist.conf \
    /etc/modprobe.d/omarchy-a16-remoteproc.conf || return 1
  add_runscript
}

help() {
  echo 'Load the audited A16 DSP stack before mounting the root filesystem.'
}
