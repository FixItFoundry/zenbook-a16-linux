#!/bin/sh
# init-premount runs after init-top udev, and before mounting root.
case "${1:-}" in prereqs) exit 0 ;; esac
. /usr/lib/zenbook-a16/dsp-policy.sh

getarg() {
    for arg in $(cat /proc/cmdline); do
        case "$arg" in "$1"=*) printf '%s\n' "${arg#*=}"; return ;; esac
    done
}
msg() { echo "$*"; }
a16_emergency() {
    echo "$1" >&2
    echo 'A16 DSP startup stopped before root mount; reboot into the DSP-disabled rescue entry.' >&2
    # initramfs-tools runs this script as a child: never return, even after shell exit.
    while :; do /bin/sh -i </dev/console >/dev/console 2>&1; done
}
run_hook
