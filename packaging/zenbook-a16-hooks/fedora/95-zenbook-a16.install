#!/usr/bin/env bash
# /etc/kernel/install.d/95-zenbook-a16.install
# Kernel-install plugin for ASUS Zenbook A16 (UX3607OA / Glymur)
# Copies device tree, ensures BLS entries have devicetree and safety cmdline,
# syncs top-level Btrfs /boot if applicable, and runs verification.
set -Eeuo pipefail

COMMAND="${1:-}"
KVER="${2:-}"
ENTRY_DIR_ABS="${3:-}"
KERNEL_IMAGE="${4:-}"

if [[ "$COMMAND" != "add" ]]; then
    exit 0
fi

if [[ -z "$KVER" ]]; then
    echo "zenbook-a16: warning: no kernel version provided to 95-zenbook-a16.install" >&2
    exit 0
fi

echo "zenbook-a16: configuring boot artifacts for kernel $KVER..."

# 1. Stage DTB
dtb_source=""
for cand in \
    "/lib/modules/$KVER/dtb/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb" \
    "/usr/lib/modules/$KVER/dtb/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb" \
    "/usr/share/zenbook-a16/dtb/glymur-asus-zenbook-a16-ux3607oa.dtb" \
    "/boot/glymur/glymur-asus-zenbook-a16-ux3607oa.dtb" \
    "/boot/glymur/$KVER.dtb" \
    "/boot/dtb-$KVER"; do
    if [[ -s "$cand" ]]; then
        dtb_source="$cand"
        break
    fi
done

if [[ -n "$dtb_source" ]]; then
    mkdir -p "/boot/dtbs/$KVER/qcom" "/boot/glymur"
    install -Dm644 "$dtb_source" "/boot/dtb-$KVER"
    install -Dm644 "$dtb_source" "/boot/dtbs/$KVER/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb"
    install -Dm644 "$dtb_source" "/boot/glymur/$KVER.dtb"
else
    echo "zenbook-a16: warning: could not find source DTB for $KVER" >&2
fi

# 2. Update BLS entries with devicetree and required cmdline parameters
REQUIRED_PARAMS=(
    "clk_ignore_unused"
    "pd_ignore_unused"
    "arm64.nopauth"
    "iommu.passthrough=0"
    "nvme_core.default_ps_max_latency_us=0"
    "pcie_aspm=off"
)

bls_dirs=("/boot/loader/entries" "/boot/efi/loader/entries")
[[ -n "$ENTRY_DIR_ABS" && -d "$ENTRY_DIR_ABS" ]] && bls_dirs+=("$ENTRY_DIR_ABS")

for bdir in "${bls_dirs[@]}"; do
    [[ -d "$bdir" ]] || continue
    for entry in "$bdir"/*"$KVER"*.conf; do
        [[ -f "$entry" ]] || continue
        # Ensure devicetree line exists
        if ! grep -q "^devicetree " "$entry"; then
            echo "devicetree /dtbs/$KVER/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb" >> "$entry"
        fi
        # Ensure required cmdline parameters exist in options
        for param in "${REQUIRED_PARAMS[@]}"; do
            if ! grep -q "$param" "$entry"; then
                sed -i "/^options / s/$/ $param/" "$entry"
            fi
        done
    done
done

# 3. Mirror boot artifacts to top-level Btrfs subvolume (subvolid=5) if applicable
is_btrfs_subvol_boot() {
    local root_fstype root_opts boot_mount
    root_fstype=$(findmnt -n -o FSTYPE / 2>/dev/null || true)
    [[ "$root_fstype" == "btrfs" ]] || return 1
    root_opts=$(findmnt -n -o OPTIONS / 2>/dev/null || true)
    [[ "$root_opts" =~ subvol= ]] || return 1
    boot_mount=$(findmnt -n -o TARGET /boot 2>/dev/null || true)
    if [[ -n "$boot_mount" && "$boot_mount" != "/" ]]; then
        return 1
    fi
    return 0
}

if is_btrfs_subvol_boot; then
    root_dev=$(findmnt -n -o SOURCE / 2>/dev/null || true)
    if [[ -n "$root_dev" ]]; then
        tmp_mnt=$(mktemp -d)
        if mount -o "rw,subvolid=5" "$root_dev" "$tmp_mnt" 2>/dev/null; then
            if [[ -d "$tmp_mnt/boot" ]]; then
                echo "zenbook-a16: mirroring /boot artifacts into Btrfs top level (subvolid=5)..."
                mkdir -p "$tmp_mnt/boot/dtbs/$KVER/qcom" "$tmp_mnt/boot/glymur"
                [[ -f "/boot/vmlinuz-$KVER" ]] && install -m 0644 "/boot/vmlinuz-$KVER" "$tmp_mnt/boot/vmlinuz-$KVER"
                [[ -f "/boot/initramfs-$KVER.img" ]] && install -m 0644 "/boot/initramfs-$KVER.img" "$tmp_mnt/boot/initramfs-$KVER.img"
                [[ -f "/boot/dtb-$KVER" ]] && install -m 0644 "/boot/dtb-$KVER" "$tmp_mnt/boot/dtb-$KVER"
                [[ -f "/boot/dtbs/$KVER/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb" ]] && \
                    install -m 0644 "/boot/dtbs/$KVER/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb" \
                        "$tmp_mnt/boot/dtbs/$KVER/qcom/glymur-asus-zenbook-a16-ux3607oa.dtb"
            fi
            umount "$tmp_mnt" 2>/dev/null || true
        fi
        rmdir "$tmp_mnt" 2>/dev/null || true
    fi
fi

# 4. Run boot verification
verifier="/usr/lib/zenbook-a16/verify-boot.py"
if [[ -x "$verifier" ]]; then
    python3 "$verifier" --bootloader grub-bls --kernel-release "$KVER"
fi
