#!/usr/bin/env bash
# Run after the distribution creates this kernel's BLS entry.
set -Eeuo pipefail
[[ ${1:-} == add ]] || exit 0
KVER=${2:?zenbook-a16: kernel release required}
[[ -x /usr/lib/zenbook-a16/verify-boot.py ]] || { echo 'zenbook-a16: required boot verifier missing' >&2; exit 1; }
python3 /usr/lib/zenbook-a16/boot-artifacts.py bls "$KVER" "${3:-}"
python3 /usr/lib/zenbook-a16/verify-boot.py --bootloader grub-bls --kernel-release "$KVER"
