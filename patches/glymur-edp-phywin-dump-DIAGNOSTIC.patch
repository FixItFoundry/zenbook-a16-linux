 static int qcom_edp_set_voltages(struct qcom_edp *edp, const struct phy_configure_opts_dp *dp_opts)
 {
 	const struct qcom_edp_swing_pre_emph_cfg *cfg;
@@ -383,12 +553,33 @@ static int qcom_edp_set_voltages(struct qcom_edp *edp, const struct phy_configur
 	if (ret)
 		return ret;
 
+	if (edp_dbg_reports > 0)
+		qcom_edp_dbg_snapshot(edp);
+
 	writel(swing, edp->tx0 + TXn_TX_DRV_LVL);
 	writel(emph, edp->tx0 + TXn_TX_EMP_POST1_LVL);
 
 	writel(swing, edp->tx1 + TXn_TX_DRV_LVL);
 	writel(emph, edp->tx1 + TXn_TX_EMP_POST1_LVL);
 
+	if (edp_dbg_reports > 0) {
+		edp_dbg_reports--;
+		qcom_edp_dbg_report(edp, "setvolt");
+	}
+
+	/*
+	 * DIAGNOSTIC -- answers three questions at once that static reading of
+	 * this driver cannot: (a) is this function reached at all, (b) which
+	 * table did is_edp select, (c) do the TX registers actually hold what we
+	 * just wrote. A readback that does not match the written value means the
+	 * offsets are wrong for this PHY generation and the tables are innocent.
+	 */
+	pr_info("XXX setvolt: is_edp=%d rate=%u lanes=%u v=%u p=%u -> swing=0x%02x emph=0x%02x | rb tx0: drv=0x%02x emp=0x%02x  tx1: drv=0x%02x emp=0x%02x\n",
+		edp->is_edp, dp_opts->link_rate, dp_opts->lanes, v_level, p_level,
+		swing, emph,
+		readl(edp->tx0 + TXn_TX_DRV_LVL), readl(edp->tx0 + TXn_TX_EMP_POST1_LVL),
+		readl(edp->tx1 + TXn_TX_DRV_LVL), readl(edp->tx1 + TXn_TX_EMP_POST1_LVL));
+
 	return 0;
 }
 
@@ -1038,8 +1229,15 @@ static int qcom_edp_phy_com_resetsm_cntrl_v8(const struct qcom_edp *edp)
 
 	writel(0x20, edp->pll + DP_QSERDES_V8_COM_RESETSM_CNTRL);
 
