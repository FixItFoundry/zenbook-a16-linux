+/*
+ * ---------------------------------------------------------------------------
+ * DIAGNOSTIC: eDP PHY register-window dump.  NOT A FIX.
+ *
+ * On glymur the swing/emphasis writes provably land in TXn_TX_DRV_LVL /
+ * TXn_TX_EMP_POST1_LVL (the readback below returns what was written) yet have
+ * no effect on the wire: the stock table, a slammed 0x1f/0x1f, and a MUX_EN
+ * variant all produce a byte-identical sink response.  The vendor UEFI
+ * DisplayDxe writes the same values to the same offsets, so tables and offsets
+ * are not the bug.  What is odd is the readback itself: a 5-bit level register
+ * returns 0x0b0b0b0b for a write of 0x0b, i.e. the byte is mirrored across all
+ * four lanes of the word.  That is not how a per-TX level register behaves,
+ * which raises the question of whether tx0/tx1 point at the real TX blocks.
+ *
+ * So: snapshot the PHY registers, do the writes, and print every register that
+ * changed.  Wherever 0x0b/0x1f actually appears is the real drive-level
+ * register.
+ *
+ * Safety: by default this only reads the four ranges the DT already maps
+ * (glymur.dtsi:2367), which the driver reads and writes anyway.  dbg_full=1
+ * additionally sweeps the gaps between the sub-blocks -- those are unproven on
+ * this SoC, so it is opt-in.
+ */
+#define GLYMUR_EDP_PHY_WIN_BASE		0x00faa000
+#define GLYMUR_EDP_PHY_WIN_LEN		0x00000d00
+#define EDP_DBG_MAX_U32			(GLYMUR_EDP_PHY_WIN_LEN / 4)
+
+static bool edp_dbg_full;
+module_param_named(dbg_full, edp_dbg_full, bool, 0644);
+MODULE_PARM_DESC(dbg_full,
+	"DIAGNOSTIC: sweep the whole 0xfaa000+0xd00 PHY window, including the unmapped gaps between sub-blocks");
+
+static int edp_dbg_reports = 3;
+module_param_named(dbg_reports, edp_dbg_reports, int, 0644);
+MODULE_PARM_DESC(dbg_reports,
+	"DIAGNOSTIC: how many set_voltages changed-register reports to print");
+
+static bool edp_dbg_full_dump_done;
+static u32 edp_dbg_snap[EDP_DBG_MAX_U32];
+static void __iomem *edp_dbg_win;
+
+struct edp_dbg_range {
+	const char *name;
+	void __iomem *base;
+	u32 len;	/* bytes */
+	u32 off;	/* where this range sits in the PHY window */
+};
+
+/* lengths are the DT reg sizes from glymur.dtsi:2367 */
+static int qcom_edp_dbg_ranges(const struct qcom_edp *edp, struct edp_dbg_range *r)
+{
+	if (edp_dbg_full) {
+		if (!edp_dbg_win)
+			edp_dbg_win = ioremap(GLYMUR_EDP_PHY_WIN_BASE,
+					      GLYMUR_EDP_PHY_WIN_LEN);
+		if (!edp_dbg_win)
+			return 0;
+
+		r[0] = (struct edp_dbg_range){ "win", edp_dbg_win,
+					       GLYMUR_EDP_PHY_WIN_LEN, 0x000 };
+		return 1;
+	}
+
+	r[0] = (struct edp_dbg_range){ "pll", edp->pll, 0x358, 0x000 };
+	r[1] = (struct edp_dbg_range){ "tx0", edp->tx0, 0x128, 0x400 };
+	r[2] = (struct edp_dbg_range){ "tx1", edp->tx1, 0x128, 0x800 };
+	r[3] = (struct edp_dbg_range){ "phy", edp->edp, 0x1d0, 0xc00 };
+	return 4;
+}
+
+static void qcom_edp_dbg_snapshot(const struct qcom_edp *edp)
+{
+	struct edp_dbg_range r[4];
+	int n, i;
+	u32 o, k = 0;
+
+	n = qcom_edp_dbg_ranges(edp, r);
+	for (i = 0; i < n; i++)
+		for (o = 0; o < r[i].len && k < EDP_DBG_MAX_U32; o += 4)
+			edp_dbg_snap[k++] = readl(r[i].base + o);
+}
+
+static void qcom_edp_dbg_report(const struct qcom_edp *edp, const char *tag)
+{
+	struct edp_dbg_range r[4];
+	int n, i, changed = 0;
+	u32 o, k = 0;
+
+	n = qcom_edp_dbg_ranges(edp, r);
+	for (i = 0; i < n; i++) {
+		for (o = 0; o < r[i].len && k < EDP_DBG_MAX_U32; o += 4) {
+			u32 now = readl(r[i].base + o);
+
+			if (now != edp_dbg_snap[k]) {
+				pr_info("XXX phydiff %s: win+0x%03x (%s+0x%03x) 0x%08x -> 0x%08x\n",
+					tag, r[i].off + o, r[i].name, o,
+					edp_dbg_snap[k], now);
+				changed++;
+			}
+			edp_dbg_snap[k++] = now;
+		}
+	}
+
+	pr_info("XXX phydiff %s: %d register(s) changed (%s)\n",
+		tag, changed, edp_dbg_full ? "full window" : "DT-mapped ranges only");
+}
+
+static void qcom_edp_dbg_dump(const struct qcom_edp *edp, const char *tag)
+{
+	struct edp_dbg_range r[4];
+	int n, i;
+	u32 o;
+
+	n = qcom_edp_dbg_ranges(edp, r);
+	pr_info("XXX phydump %s: %s\n",
+		tag, edp_dbg_full ? "full window" : "DT-mapped ranges only");
+
+	for (i = 0; i < n; i++) {
+		for (o = 0; o + 32 <= r[i].len; o += 32) {
+			u32 v[8];
+			int j;
+
+			for (j = 0; j < 8; j++)
+				v[j] = readl(r[i].base + o + j * 4);
+
+			if (!(v[0] | v[1] | v[2] | v[3] | v[4] | v[5] | v[6] | v[7]))
+				continue;	/* skip all-zero lines */
+
+			pr_info("XXX phydump %s win+0x%03x (%s+0x%03x): %08x %08x %08x %08x %08x %08x %08x %08x\n",
+				tag, r[i].off + o, r[i].name, o,
+				v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+		}
+	}
+}
