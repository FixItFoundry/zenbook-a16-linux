From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jesse Casco <jesse.casco@gmail.com>
Date: Sat, 19 Sep 2026 10:16:31 -0400
Subject: [PATCH 18/24] LOCAL COMPAT: A16 Wi-Fi and Bluetooth power sequencing

Selected net board hunks from test4 ffc9a506cae6, split for RC3 review. Historical comments describe prior experiments, not new validation. Not an upstream-ready patch; effective DT comparison and hardware validation pending.
---
 .../qcom/glymur-asus-zenbook-a16-ux3607oa.dts | 117 +++++++++++++++++-
 1 file changed, 111 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
index 40433dc2d6cf935178d9ca47d0c751fd3913bbf9..86ac3f83dff8703681c3a95de85f69924c511c0c 100644
--- a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
@@ -266,6 +266,16 @@ vreg_wcn_3p3: regulator-wcn-3p3 {
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
 
+		/*
+		 * GLYMUR-A16: qcom_wcn pwrseq asserts this rail for the power
+		 * sequence and then releases it, so nothing holds a vote and
+		 * regulator_init_complete() switches it off at t+30s
+		 * (VREG_WCN_3P3: disabling), taking ath12k down ~60s later.
+		 * The 7.1 tree only avoided this by reserving tlmm 94 so the
+		 * regulator never probed and the firmware ON state persisted.
+		 */
+		regulator-always-on;
+
 		gpio = <&tlmm 94 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 
@@ -275,6 +285,82 @@ vreg_wcn_3p3: regulator-wcn-3p3 {
 		regulator-boot-on;
 	};
 
+	/*
+	 * GLYMUR-A16: Wi-Fi is brought up with the qcom,wcn7850-pmu power
+	 * sequencer (our verified-working 7.1 mechanism), not the generic
+	 * pcie-m2-e-connector + pwrseq path, which never binds on 7.2-rc3.
+	 */
+	vreg_wcn_0p95: regulator-wcn-0p95 {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_WCN_0P95";
+		regulator-min-microvolt = <950000>;
+		regulator-max-microvolt = <950000>;
+
+		regulator-always-on;
+
+		vin-supply = <&vreg_wcn_3p3>;
+	};
+
+	wcn7850-pmu {
+		compatible = "qcom,wcn7850-pmu";
+
+		vdd-supply = <&vreg_wcn_0p95>;
+		vddio-supply = <&vreg_l15b_e0>;
+		vddaon-supply = <&vreg_l15b_e0>;
+		vdddig-supply = <&vreg_l15b_e0>;
+		vddrfa1p2-supply = <&vreg_l15b_e0>;
+		vddrfa1p8-supply = <&vreg_l15b_e0>;
+
+		wlan-enable-gpios = <&tlmm 117 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 116 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&wcn_wlan_bt_en>;
+		pinctrl-names = "default";
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
+	};
+
 	reserved-memory {
 		linux,cma {
 			compatible = "shared-dma-pool";
@@ -336,12 +422,11 @@ wlan-connector {
 		vpcie3v3-supply = <&vreg_wcn_3p3>;
 		vpcie1v8-supply = <&vreg_l15b_e0>;
 
-		w-disable1-gpios = <&tlmm 117 GPIO_ACTIVE_LOW>;
-		w-disable2-gpios = <&tlmm 116 GPIO_ACTIVE_LOW>;
-
-		pinctrl-0 = <&wcn_wlan_bt_en>;
-		pinctrl-names = "default";
-
+		/*
+		 * GLYMUR-A16: pin/gpio ownership (tlmm 116/117, wcn_wlan_bt_en)
+		 * moved to wcn7850-pmu; this node is kept only as the PCIe/UART
+		 * graph anchor so the endpoint labels resolve.
+		 */
 		ports {
 			#address-cells = <1>;
 			#size-cells = <0>;
@@ -1132,6 +1217,26 @@ wake-n-pins {
 &uart14 {
 	status = "okay";
 
+	/*
+	 * GLYMUR-A16: WCN7850 Bluetooth. Konrad's tree enables this UART and wires it
+	 * into the pcie-m2-e-connector graph but declares no serdev child, so nothing
+	 * probes a BT controller (bluetooth.service inactive, zero hci devices, no
+	 * Bluetooth in rfkill). Supplies come from the qcom,wcn7850-pmu node we add for
+	 * Wi-Fi, so these labels already resolve. Needs hci_uart + btqca.
+	 */
+	bluetooth {
+		compatible = "qcom,wcn7850-bt";
+		max-speed = <3200000>;
+
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+	};
+
 	port {
 		uart14_ep: endpoint {
 			remote-endpoint = <&m2_e_uart_ep>;
