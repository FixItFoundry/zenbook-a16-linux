diff --git a/drivers/gpu/drm/msm/msm_drv.c b/drivers/gpu/drm/msm/msm_drv.c
index cc2bcd14b..c6d087b93 100644
--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -50,6 +50,60 @@ bool dumpstate;
 MODULE_PARM_DESC(dumpstate, "Dump KMS state on errors");
 module_param(dumpstate, bool, 0600);
 
+/*
+ * GLYMUR CRASH BISECT - DIAGNOSTIC ONLY, do not upstream.
+ *
+ * The ASUS Zenbook A16 (Snapdragon X2 Elite) hard-resets during display
+ * power-down. Established 2026-07-25: Linux emits NO fault. netconsole with a
+ * provably empty queue (7 lines in the final 5s) delivered the trigger message
+ * and then the SoC was simply gone, and ramoops on a genuine test69 cycle came
+ * back empty - i.e. kmsg_dump never ran. Something outside Linux (TZ, secure
+ * watchdog, hw) resets the SoC, so there is no trace to read.
+ *
+ * With no trace available, localise the fault by skipping one teardown step at
+ * a time and observing whether the crash stops. Writable at runtime (0644) so
+ * all four candidates can be tried without rebuilding msm.
+ *
+ *   1 = skip msm_dp_ctrl_phy_exit()            (DP PHY stays powered)
+ *   2 = skip DP core clk disable               (core_clks stay on)
+ *   4 = skip dev_pm_opp_set_rate(dev, 0)       (DPU core clk not driven to 0)
+ *   8 = skip icc_set_bw(path, 0, 0)            (interconnect vote not dropped)
+ *  16 = skip phy_exit() but clear phy_initialized so enable re-runs phy_init
+ *  32 = skip only msm_dp_ctrl_phy_reset() inside msm_dp_ctrl_phy_exit()
+ *  64 = DEFER the phy power-down ~1s instead of skipping it (candidate FIX)
+ *
+ * Results so far (2026-07-25), screen-off unless noted:
+ *   0  baseline      dies      1  dies on screen-ON after surviving off
+ *   2  untested      4  dies    8  dies      16 dies on screen-ON
+ *   32 dies          PHYSKIP=1 dies   PHYSKIP=2 dies   PHYSKIP=3 dies on ON
+ *
+ * So msm_dp_ctrl_phy_exit() is the trigger and BOTH its halves are
+ * independently lethal - it is not a specific clock or rail, it is that the
+ * eDP PHY gives anything up ~120ms before the DPU has finished tearing down.
+ * Breaking the far end instead (bits 4 and 8) does not help either.
+ *
+ * Every config that survives the off does so by leaving the PHY powered, and
+ * every one of those then dies on screen-ON in the DPU commit path (no DP code
+ * runs at all). Bit 64 is the only arrangement that gets both a surviving off
+ * AND a properly exited PHY: keep the exit, move it out of the fatal window.
+ *
+ * "Each skip is symmetric" was the original claim, on the grounds that every
+ * enable path is guarded on the same state flag a skipped disable leaves set.
+ * DISPROVEN for bit 1 on 2026-07-25: it survived 60s of screen-off (the first
+ * thing ever to do so) and then hard-reset the SoC on screen-on. Leaving
+ * phy_initialized set makes the flag symmetric but not the hardware - the DP
+ * core clocks still go off and pm_runtime still suspends in between, so enable
+ * skipped msm_dp_ctrl_phy_init() on a PHY that had lost its programming.
+ *
+ * Bit 16 is the corrected form of bit 1 and the one to trust. Bits 4 and 8 skip
+ * only in the zero direction, so those two remain genuinely symmetric.
+ */
+unsigned int glymur_skip;
+MODULE_PARM_DESC(glymur_skip,
+	"glymur crash bisect: 1=phy_exit 2=core_clk_dis 4=opp_rate0 8=icc_bw0 "
+	"16=phy_exit+reinit 32=phy_reset_only 64=defer_phy_powerdown");
+module_param(glymur_skip, uint, 0644);
+
 static bool modeset = true;
 MODULE_PARM_DESC(modeset, "Use kernel modesetting [KMS] (1=on (default), 0=disable)");
 module_param(modeset, bool, 0600);
diff --git a/drivers/phy/qualcomm/phy-qcom-edp.c b/drivers/phy/qualcomm/phy-qcom-edp.c
index a3c893f72..78541bfd4 100644
--- a/drivers/phy/qualcomm/phy-qcom-edp.c
+++ b/drivers/phy/qualcomm/phy-qcom-edp.c
@@ -1232,12 +1232,49 @@ static int qcom_edp_phy_set_mode(struct phy *phy, enum phy_mode mode, int submod
 	return 0;
 }
 
+/*
+ * GLYMUR crash bisect, phy half. See msm_drv.c for the msm half (glymur_skip).
+ *
+ * Established 2026-07-25 with the msm-side bitmask: the ASUS Zenbook A16 hard
+ * resets on eDP power-down, and qcom_edp_phy_exit() is the trigger.
+ *   msm bit 16 (phy_exit not called at all) -> survives 60s of screen-off, x2
+ *   msm bit 32 (phy_reset skipped, phy_exit still called) -> dies, x2
+ * so msm_dp_ctrl_phy_reset() is exonerated and everything below is suspect.
+ *
+ * This splits the remaining two calls:
+ *   1 = skip clk_bulk_disable_unprepare()  - aux, cfg_ahb, ref stay enabled
+ *   2 = skip regulator_bulk_disable()      - vdda-phy, vdda-pll stay enabled
+ *
+ * On glymur (decoded from the live DT, phandles resolved):
+ *   aux     = dispcc DISP_CC_MDSS_DPTX3_AUX_CLK
+ *   cfg_ahb = dispcc DISP_CC_MDSS_AHB_CLK  <- display-subsystem-wide, not
+ *                                             PHY-private. Prime suspect.
+ *   vdda-phy = ldo2, this PHY is its only consumer in the whole tree
+ *   vdda-pll = ldo4, shared only with the two PCIe PHYs, which never probe
+ *              here - so it likely has no other vote and really powers off
+ *
+ * Skipping a disable makes the matching enable in qcom_edp_phy_init() a
+ * refcount increment rather than a no-op, so counts drift by one per off/on
+ * cycle. Fine for a bisect, not a fix.
+ */
+static unsigned int glymur_phy_skip;
+MODULE_PARM_DESC(glymur_phy_skip,
+	"glymur crash bisect: 1=skip clk_bulk_disable 2=skip regulator_bulk_disable");
+module_param(glymur_phy_skip, uint, 0644);
+
 static int qcom_edp_phy_exit(struct phy *phy)
 {
 	struct qcom_edp *edp = phy_get_drvdata(phy);
 
-	clk_bulk_disable_unprepare(edp->num_clks, edp->clks);
-	regulator_bulk_disable(ARRAY_SIZE(edp->supplies), edp->supplies);
+	if (glymur_phy_skip & 1)
+		pr_info("GLYMUR-PHY: skip clk_bulk_disable_unprepare\n");
+	else
+		clk_bulk_disable_unprepare(edp->num_clks, edp->clks);
+
+	if (glymur_phy_skip & 2)
+		pr_info("GLYMUR-PHY: skip regulator_bulk_disable\n");
+	else
+		regulator_bulk_disable(ARRAY_SIZE(edp->supplies), edp->supplies);
 
 	return 0;
 }
