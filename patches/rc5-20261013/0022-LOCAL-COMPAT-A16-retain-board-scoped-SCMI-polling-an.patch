From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jesse Casco <jesse.casco@gmail.com>
Date: Sat, 19 Sep 2026 10:17:08 -0400
Subject: [PATCH 23/24] LOCAL COMPAT: A16 retain board-scoped SCMI polling and
 attached SOCCP defaults

Do not carry the duplicate SoC-wide polling patch or obsolete asus,soccp-glink node. This preserves effective known DT behavior for CPUCP and the existing firmware-attached remoteproc; not a proven upstream requirement.
---
 .../boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts    | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
index 127d09869005842bc23627bc2a4c6aeddcf9c861..e2e6d24e3eb1be733bc09469109b6d38cfc6bbd1 100644
--- a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
@@ -1016,8 +1016,7 @@ &remoteproc_cdsp {
 };
 
 &remoteproc_soccp {
-	firmware-name = "qcom/glymur/ASUSTeK/UX3607OA/soccp.mbn",
-			"qcom/glymur/ASUSTeK/UX3607OA/soccp_dtb.mbn";
+	/* Firmware-attached SOCCP: preserve the current DT's default names. */
 };
 
 &smb2370_j_e2_eusb2_repeater {
@@ -1465,6 +1464,11 @@ &usb_mp_qmpphy1 {
 	status = "okay";
 };
 
+/* Compatibility only; built-in CPUCP versus polling needs a separate trial. */
+&{/firmware/scmi} {
+	arm,no-completion-irq;
+};
+
 /* Local compatibility: retain the validated CPU/LLC cooling-map coverage. */
 &{/thermal-zones/cpu-0-0-0-thermal} {
 	polling-delay-passive = <100>;
