diff --git a/drivers/gpu/drm/msm/dp/dp_panel.c b/drivers/gpu/drm/msm/dp/dp_panel.c
index 891211b23..fa5a598a5 100644
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -168,8 +168,17 @@ static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
 				link_info->rate_set = i;
 			}
 
-			/* Only use LINK_RATE_SET if LINK_BW_SET hasn't already been written to */
-			if (!bw_set && link_info->rate)
+			/*
+			 * Only use LINK_RATE_SET if LINK_BW_SET hasn't already been written to.
+			 *
+			 * EXPERIMENT (glymur): a sink that reports MAX_LINK_RATE == 0 has no
+			 * legacy rate to select, so LINK_RATE_SET is the only sanctioned way
+			 * to pick a rate for it (eDP 1.4, DP_SUPPORTED_LINK_RATES). On this
+			 * machine the UEFI trains the panel at boot and leaves LINK_BW_SET
+			 * = 0x14 behind, so the !bw_set guard alone silently drops us onto
+			 * the legacy path (logs: "use_rate_set=0" with 0x100 reading 0x14).
+			 */
+			if (link_info->rate && (!bw_set || !dpcd[DP_MAX_LINK_RATE]))
 				link_info->use_rate_set = true;
 		}
 	}
