+		iris_genpd_set_hwmode(core->apv, !hw_mode);
+restore_vpp1_domain_mode:
+	if (!(efuse_value & DISABLE_VIDEO_VPP1_BIT))
+		iris_genpd_set_hwmode(core->vcodec_vpp1, !hw_mode);
