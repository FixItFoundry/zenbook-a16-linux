From 8d64c8a237abbd550cb5d4af2165c10ec201c9e1 Mon Sep 17 00:00:00 2001
From: Jesse Casco <jesse.casco@gmail.com>
Date: Tue, 10 Nov 2026 15:59:43 -0500
Subject: [PATCH 145/152] drm/msm/dp: restore rate_set with the rate on a lane
 down-shift

msm_dp_ctrl_link_lane_down_shift() restores the starting link rate when
it halves the lane count, but keeps a rate_set that an earlier rate
down-shift may have lowered. LINK_RATE_SET then selects a lower table
rate than the PHY is set up for. Restore rate_set together with the
rate.

Signed-off-by: Jesse Casco <jesse.casco@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 75cd4d2e9e6e..1d7726c51844 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1552,6 +1552,7 @@ static int msm_dp_ctrl_link_lane_down_shift(struct msm_dp_ctrl_private *ctrl,
 
 	ctrl->link->link_params.num_lanes /= 2;
 	ctrl->link->link_params.rate = panel->link_info.rate;
+	ctrl->link->link_params.rate_set = panel->link_info.rate_set;
 
 	ctrl->link->phy_params.p_level = 0;
 	ctrl->link->phy_params.v_level = 0;
-- 
2.56.0

