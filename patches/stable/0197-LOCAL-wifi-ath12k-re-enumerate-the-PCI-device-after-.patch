From ac9aff87e0ea28d112aabaa2be16212091a21b11 Mon Sep 17 00:00:00 2001
From: scalpel4k <scalpel4k@gmail.com>
Date: Fri, 20 Nov 2026 16:23:52 +0100
Subject: [PATCH] LOCAL: wifi: ath12k: re-enumerate the PCI device after a
 failed resume

On the Zenbook A16 the QCC2072 sporadically does not come back from
s2idle, independent of the sleep length: the device's primary boot
loader starts the BHI image download and never reports back ("MHI did
not load image over BHI, ret: -110"). Supply, PERST#, W_DISABLE and the
PCIe link are unchanged across the cycle. Afterwards every resume fails
with -22 ("failed to set mhi state INIT(0) in current mhi state (0x1)")
and Wi-Fi stays gone until reboot.

Unbinding and binding the driver does not recover the device; removing
and rescanning it does. Do that from the driver, like iwlwifi's removal
work: when the resume fails, queue a work item on system_freezable_wq
that removes the device and rescans the parent bus. The freezable
workqueue only runs after the system resume has finished and the tasks
are thawed.
---
 drivers/net/wireless/ath/ath12k/pci.c | 59 ++++++++++++++++++++++++++-
 1 file changed, 58 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/ath/ath12k/pci.c b/drivers/net/wireless/ath/ath12k/pci.c
index 9dbdfeb..3d0cc04 100644
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -1775,14 +1775,71 @@ static __maybe_unused int ath12k_pci_pm_suspend(struct device *dev)
 	return ret;
 }
 
+struct ath12k_pci_rescan {
+	struct pci_dev *pdev;
+	struct work_struct work;
+};
+
+static void ath12k_pci_rescan_work(struct work_struct *work)
+{
+	struct ath12k_pci_rescan *rescan =
+		container_of(work, struct ath12k_pci_rescan, work);
+	struct pci_dev *pdev = rescan->pdev;
+	struct pci_bus *bus;
+
+	pci_lock_rescan_remove();
+
+	/* something else removed the device already */
+	bus = pdev->bus;
+	if (bus) {
+		pci_info(pdev, "re-enumerating after failed resume\n");
+		pci_stop_and_remove_bus_device(pdev);
+		pci_rescan_bus(bus->parent ? bus->parent : bus);
+	}
+
+	pci_unlock_rescan_remove();
+
+	pci_dev_put(pdev);
+	kfree(rescan);
+	module_put(THIS_MODULE);
+}
+
+/*
+ * Sometimes the device's boot loader does not take the firmware image after
+ * resume ("MHI did not load image over BHI"), and the driver is left in a
+ * state where every later resume fails too. Rebinding the driver does not
+ * help; removing and rescanning the PCI device does. Do that once the
+ * system resume is done: the freezable workqueue runs only after the tasks
+ * are thawed.
+ */
+static void ath12k_pci_schedule_rescan(struct pci_dev *pdev)
+{
+	struct ath12k_pci_rescan *rescan;
+
+	if (!try_module_get(THIS_MODULE))
+		return;
+
+	rescan = kzalloc_obj(*rescan);
+	if (!rescan) {
+		module_put(THIS_MODULE);
+		return;
+	}
+
+	rescan->pdev = pci_dev_get(pdev);
+	INIT_WORK(&rescan->work, ath12k_pci_rescan_work);
+	queue_work(system_freezable_wq, &rescan->work);
+}
+
 static __maybe_unused int ath12k_pci_pm_resume(struct device *dev)
 {
 	struct ath12k_base *ab = dev_get_drvdata(dev);
 	int ret;
 
 	ret = ath12k_core_resume(ab);
-	if (ret)
+	if (ret) {
 		ath12k_warn(ab, "failed to resume core: %d\n", ret);
+		ath12k_pci_schedule_rescan(to_pci_dev(dev));
+	}
 
 	return ret;
 }
