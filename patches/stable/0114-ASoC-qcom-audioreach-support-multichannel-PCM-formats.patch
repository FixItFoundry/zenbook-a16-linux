+	for (i = 0; i < PCM_MAX_NUM_CHANNEL; i++)
 		if (cfg->channel_map[i])
 			intf_cfg->cfg.active_channels_mask |= BIT(i);
 
@@ -896,7 +879,7 @@ static int audioreach_mfc_set_media_format(struct q6apm_graph *graph,
