From a56d72a3d5fb588e525827da928f8750f8458798 Mon Sep 17 00:00:00 2001
From: Tapas Rana <tapas.rana@oss.qualcomm.com>
Date: Tue, 17 Nov 2026 16:25:09 +0530
Subject: [PATCH] FROMLIST: arm64: dts: qcom: glymur: Add mode-switch to the
 USB controllers

When the USB3-DP combo PHY is a mode switch, DisplayPort pin
assignments C and E put it in DP-only mode, where it stops the USB3
PIPE clock. Add mode-switch to the USB controllers as well, so that
they get the Type-C mode, move to the UTMI clock first and keep their
USB 2.0 ports working.

Link: https://lore.kernel.org/all/20261117113834.925310-1-tapas.rana@oss.qualcomm.com/
Signed-off-by: Tapas Rana <tapas.rana@oss.qualcomm.com>
---
 arch/arm64/boot/dts/qcom/glymur.dtsi | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/glymur.dtsi b/arch/arm64/boot/dts/qcom/glymur.dtsi
index b4db417..fcee168 100644
--- a/arch/arm64/boot/dts/qcom/glymur.dtsi
+++ b/arch/arm64/boot/dts/qcom/glymur.dtsi
@@ -5033,6 +5033,7 @@
 			snps,dis_enblslpm_quirk;
 			snps,resume-hs-terminations;
 
+			mode-switch;
 			usb-role-switch;
 			wakeup-source;
 
@@ -5124,6 +5125,7 @@
 			snps,dis_enblslpm_quirk;
 			snps,resume-hs-terminations;
 
+			mode-switch;
 			usb-role-switch;
 			wakeup-source;
 
@@ -5215,6 +5217,7 @@
 			snps,dis_enblslpm_quirk;
 			snps,resume-hs-terminations;
 
+			mode-switch;
 			usb-role-switch;
 			wakeup-source;
 
