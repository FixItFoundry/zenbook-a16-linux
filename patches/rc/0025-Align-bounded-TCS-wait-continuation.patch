From 6a91c174ebcaa5b14d766461c00cbe68fbdc4b96 Mon Sep 17 00:00:00 2001
From: Jesse Casco <jesse.casco@gmail.com>
Date: Tue, 6 Oct 2026 15:48:49 -0400
Subject: [PATCH 025/100] Align bounded TCS wait continuation

Signed-off-by: Jesse Casco <jesse.casco@gmail.com>
---
 drivers/soc/qcom/rpmh-rsc.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/qcom/rpmh-rsc.c b/drivers/soc/qcom/rpmh-rsc.c
index a3c8ebf17efa..b339c6f77e27 100644
--- a/drivers/soc/qcom/rpmh-rsc.c
+++ b/drivers/soc/qcom/rpmh-rsc.c
@@ -672,8 +672,8 @@ int rpmh_rsc_send_data(struct rsc_drv *drv, const struct tcs_request *msg)
 
 	/* A missing acknowledgment must not block every subsequent voter. */
 	time_left = wait_event_lock_irq_timeout(drv->tcs_wait,
-			    (tcs_id = claim_tcs_for_req(drv, tcs, msg)) >= 0,
-			    drv->lock, msecs_to_jiffies(10000));
+						(tcs_id = claim_tcs_for_req(drv, tcs, msg)) >= 0,
+						drv->lock, msecs_to_jiffies(10000));
 	if (!time_left) {
 		spin_unlock_irq(&drv->lock);
 		dev_err(drv->dev, "TCS unavailable for RPMh address %#x\n",
