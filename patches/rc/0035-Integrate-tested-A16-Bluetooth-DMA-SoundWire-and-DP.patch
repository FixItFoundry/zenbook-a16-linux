Signed-off-by: Jesse Casco <jesse.casco@gmail.com>
---
 drivers/bluetooth/btqca.c                 | 35 ++++++++++++--
 drivers/dma/qcom/gpi.c                    |  1 +
 drivers/gpu/drm/msm/dp/dp_ctrl.c          | 58 ++++++++++++++++++-----
 drivers/gpu/drm/msm/dp/dp_display.c       | 19 ++++++--
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c | 11 ++++-
 drivers/soundwire/qcom.c                  |  2 +-
 6 files changed, 105 insertions(+), 21 deletions(-)

diff --git a/drivers/bluetooth/btqca.c b/drivers/bluetooth/btqca.c
index 002307000d3c..51dc38c4995b 100644
--- a/drivers/bluetooth/btqca.c
+++ b/drivers/bluetooth/btqca.c
@@ -713,6 +713,16 @@ static int qca_check_bdaddr(struct hci_dev *hdev, const struct qca_fw_config *co
 	return 0;
 }
 
+/* The observed Cologne 1.0 identity uses a distinct firmware-name family. */
+static bool qca_is_cln10(enum qca_btsoc_type soc_type,
+			 struct qca_btsoc_version ver)
+{
+	return soc_type == QCA_WCN7850 &&
+	       le32_to_cpu(ver.product_id) == 0x20 &&
+	       le32_to_cpu(ver.soc_id) == 0x40292100 &&
+	       le16_to_cpu(ver.rom_ver) == 0x0101;
+}
+
 static void qca_get_nvm_name_by_board(char *fwname, size_t max_size,
 		const char *stem, enum qca_btsoc_type soc_type,
 		struct qca_btsoc_version ver, u8 rom_ver, u16 bid)
@@ -720,6 +730,15 @@ static void qca_get_nvm_name_by_board(char *fwname, size_t max_size,
 	const char *variant;
 	const char *prefix;
 
+	if (qca_is_cln10(soc_type, ver) && !strcmp(stem, "clnbtnv10")) {
+		if ((bid >> 8) > 1 || !(bid & 0xff))
+			snprintf(fwname, max_size, "qca/%s.bin", stem);
+		else
+			snprintf(fwname, max_size, "qca/%s.b%0*x", stem,
+				 bid >> 8 ? 4 : 2, bid);
+		return;
+	}
+
 	/* Set the default value to variant and prefix */
 	variant = "";
 	prefix = "b";
@@ -824,8 +843,12 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 				 "qca/wcnhpbtfw%02x.tlv", rom_ver);
 			break;
 		case QCA_WCN7850:
-			snprintf(config.fwname, sizeof(config.fwname),
-				 "qca/hmtbtfw%02x.tlv", rom_ver);
+			if (qca_is_cln10(soc_type, ver))
+				snprintf(config.fwname, sizeof(config.fwname),
+					 "qca/clnbtfw10.tlv");
+			else
+				snprintf(config.fwname, sizeof(config.fwname),
+					 "qca/hmtbtfw%02x.tlv", rom_ver);
 			break;
 		default:
 			snprintf(config.fwname, sizeof(config.fwname),
@@ -918,8 +941,12 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 						  "wcnhpnv", soc_type, ver, rom_ver, boardid);
 			break;
 		case QCA_WCN7850:
-			qca_get_nvm_name_by_board(config.fwname, sizeof(config.fwname),
-				 "hmtnv", soc_type, ver, rom_ver, boardid);
+			if (qca_is_cln10(soc_type, ver))
+				qca_get_nvm_name_by_board(config.fwname, sizeof(config.fwname),
+					 "clnbtnv10", soc_type, ver, 0, boardid);
+			else
+				qca_get_nvm_name_by_board(config.fwname, sizeof(config.fwname),
+					 "hmtnv", soc_type, ver, rom_ver, boardid);
 			break;
 		default:
 			snprintf(config.fwname, sizeof(config.fwname),
diff --git a/drivers/dma/qcom/gpi.c b/drivers/dma/qcom/gpi.c
index 665d8a0bbaf8..763a4daf7542 100644
--- a/drivers/dma/qcom/gpi.c
+++ b/drivers/dma/qcom/gpi.c
@@ -2023,6 +2023,7 @@ static void gpi_free_chan_resources(struct dma_chan *chan)
 	gpi_free_ring(&gchan->ch_ring, gpii);
 	vchan_free_chan_resources(&gchan->vc);
 	kfree(gchan->config);
+	gchan->config = NULL;
 
 	write_lock_irq(&gpii->pm_lock);
 	gchan->pm_state = DISABLE_STATE;
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index dfebcc0ff3ee..86ceef0aa631 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -142,6 +142,7 @@ struct msm_dp_ctrl_private {
 	bool core_clks_on;
 	bool link_clks_on;
 	bool stream_clks_on[DP_STREAM_MAX];
+	bool phy_powered_on;
 };
 
 static inline u32 msm_dp_read_ahb(const struct msm_dp_ctrl_private *ctrl, u32 offset)
@@ -1886,6 +1887,9 @@ static void msm_dp_ctrl_link_clk_disable(struct msm_dp_ctrl *msm_dp_ctrl)
 
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
 
+	if (!ctrl->link_clks_on)
+		return;
+
 	clk_bulk_disable_unprepare(ctrl->num_link_clks, ctrl->link_clks);
 
 	ctrl->link_clks_on = false;
@@ -1897,6 +1901,20 @@ static void msm_dp_ctrl_link_clk_disable(struct msm_dp_ctrl *msm_dp_ctrl)
 		   str_on_off(ctrl->core_clks_on));
 }
 
+static int msm_dp_ctrl_phy_power_off(struct msm_dp_ctrl_private *ctrl)
+{
+	int ret;
+
+	if (!ctrl->phy_powered_on)
+		return 0;
+
+	ret = phy_power_off(ctrl->phy);
+	if (!ret)
+		ctrl->phy_powered_on = false;
+
+	return ret;
+}
+
 static int msm_dp_ctrl_enable_mainlink_clocks(struct msm_dp_ctrl_private *ctrl,
 					      struct msm_dp_panel *panel)
 {
@@ -1908,13 +1926,23 @@ static int msm_dp_ctrl_enable_mainlink_clocks(struct msm_dp_ctrl_private *ctrl,
 	ctrl->phy_opts.dp.link_rate = ctrl->link->link_params.rate / 100;
 	ctrl->phy_opts.dp.ssc = drm_dp_max_downspread(dpcd);
 
-	phy_configure(phy, &ctrl->phy_opts);
-	phy_power_on(phy);
+	ret = phy_configure(phy, &ctrl->phy_opts);
+	if (ret)
+		return ret;
+
+	if (!ctrl->phy_powered_on) {
+		ret = phy_power_on(phy);
+		if (ret)
+			return ret;
+		ctrl->phy_powered_on = true;
+	}
 
 	dev_pm_opp_set_rate(ctrl->dev, ctrl->link->link_params.rate * 1000);
 	ret = msm_dp_ctrl_link_clk_enable(&ctrl->msm_dp_ctrl);
-	if (ret)
+	if (ret) {
 		DRM_ERROR("Unable to start link clocks. ret=%d\n", ret);
+		msm_dp_ctrl_phy_power_off(ctrl);
+	}
 
 	drm_dbg_dp(ctrl->drm_dev, "link rate=%d\n", ctrl->link->link_params.rate);
 
@@ -2055,12 +2083,13 @@ void msm_dp_ctrl_phy_exit(struct msm_dp_ctrl *msm_dp_ctrl)
 static int msm_dp_ctrl_reinitialize_mainlink(struct msm_dp_ctrl_private *ctrl,
 					     struct msm_dp_panel *panel)
 {
-	struct phy *phy = ctrl->phy;
 	int ret = 0;
 
 	msm_dp_ctrl_mainlink_disable(ctrl);
 	ctrl->phy_opts.dp.lanes = ctrl->link->link_params.num_lanes;
-	phy_configure(phy, &ctrl->phy_opts);
+	ret = phy_configure(ctrl->phy, &ctrl->phy_opts);
+	if (ret)
+		return ret;
 
 	/*
 	 * Disable and re-enable the mainlink clock since the
@@ -2069,7 +2098,9 @@ static int msm_dp_ctrl_reinitialize_mainlink(struct msm_dp_ctrl_private *ctrl,
 	 */
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
+	ret = msm_dp_ctrl_phy_power_off(ctrl);
+	if (ret)
+		return ret;
 	/* hw recommended delay before re-enabling clocks */
 	msleep(20);
 
@@ -2086,6 +2117,7 @@ static int msm_dp_ctrl_deinitialize_mainlink(struct msm_dp_ctrl_private *ctrl,
 					     struct msm_dp_panel *panel)
 {
 	struct phy *phy;
+	int ret;
 
 	phy = ctrl->phy;
 
@@ -2095,7 +2127,9 @@ static int msm_dp_ctrl_deinitialize_mainlink(struct msm_dp_ctrl_private *ctrl,
 
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
+	ret = msm_dp_ctrl_phy_power_off(ctrl);
+	if (ret)
+		return ret;
 
 	/* aux channel down, reinit phy */
 	phy_exit(phy);
@@ -2515,7 +2549,8 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl,
 		rc = msm_dp_ctrl_reinitialize_mainlink(ctrl, panel);
 		if (rc) {
 			DRM_ERROR("Failed to reinitialize mainlink. rc=%d\n", rc);
-			break;
+			msm_dp_ctrl_deinitialize_mainlink(ctrl, panel);
+			return rc;
 		}
 	}
 
@@ -2728,10 +2763,9 @@ void msm_dp_ctrl_off_link(struct msm_dp_ctrl *msm_dp_ctrl,
 			  struct msm_dp_panel *panel)
 {
 	struct msm_dp_ctrl_private *ctrl;
-	struct phy *phy;
+	int ret;
 
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
-	phy = ctrl->phy;
 
 	msm_dp_ctrl_mainlink_disable(ctrl);
 
@@ -2739,7 +2773,9 @@ void msm_dp_ctrl_off_link(struct msm_dp_ctrl *msm_dp_ctrl,
 
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
+	ret = msm_dp_ctrl_phy_power_off(ctrl);
+	if (ret)
+		DRM_ERROR("Failed to power off DP PHY. ret=%d\n", ret);
 }
 
 irqreturn_t msm_dp_ctrl_isr(struct msm_dp_ctrl *msm_dp_ctrl,
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 9299ce616fdb..dd69e9507707 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -634,6 +634,8 @@ static int msm_dp_display_prepare_link(struct msm_dp_display_private *dp)
 	struct msm_dp *msm_dp_display = &dp->msm_dp_display;
 	int rc = 0;
 	bool force_link_train = false;
+	bool phy_deinit = false;
+	bool link_prepared = false;
 
 	drm_dbg_dp(dp->drm_dev, "sink_count=%d\n", dp->link->sink_count);
 
@@ -650,7 +652,7 @@ static int msm_dp_display_prepare_link(struct msm_dp_display_private *dp)
 		return -ENOTCONN;
 
 	if (!msm_dp_display->power_on) {
-		msm_dp_display_host_phy_init(dp);
+		phy_deinit = msm_dp_display_host_phy_init(dp);
 		force_link_train = true;
 	}
 
@@ -658,10 +660,21 @@ static int msm_dp_display_prepare_link(struct msm_dp_display_private *dp)
 	if (rc) {
 		DRM_ERROR("Failed link training (rc=%d)\n", rc);
 		// TODO: schedule drm_connector_set_link_status_property()
-		return rc;
+		goto error;
 	}
 
-	return msm_dp_ctrl_prepare_stream_on(dp->ctrl, dp->panel, force_link_train);
+	link_prepared = !msm_dp_display->power_on;
+	rc = msm_dp_ctrl_prepare_stream_on(dp->ctrl, dp->panel, force_link_train);
+	if (!rc)
+		return 0;
+
+error:
+	if (link_prepared)
+		msm_dp_ctrl_off_link(dp->ctrl, dp->panel);
+	if (phy_deinit)
+		msm_dp_display_host_phy_exit(dp);
+
+	return rc;
 }
 
 static int msm_dp_display_enable(struct msm_dp_display_private *dp,
diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 4d835ee8995c..1a125acbb4e8 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -4290,6 +4290,7 @@ static int qmp_combo_dp_power_on(struct phy *phy)
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
 	void __iomem *tx = qmp->dp_tx;
 	void __iomem *tx2 = qmp->dp_tx2;
+	int ret;
 
 	mutex_lock(&qmp->phy_mutex);
 
@@ -4302,13 +4303,19 @@ static int qmp_combo_dp_power_on(struct phy *phy)
 	cfg->configure_dp_tx(qmp);
 
 	/* Configure link rate, swing, etc. */
-	cfg->configure_dp_phy(qmp);
+	ret = cfg->configure_dp_phy(qmp);
+	if (ret) {
+		writel(DP_PHY_PD_CTL_PSR_PWRDN,
+		       qmp->dp_dp_phy + QSERDES_DP_PHY_PD_CTL);
+		goto out_unlock;
+	}
 
 	qmp->dp_powered_on = true;
 
+out_unlock:
 	mutex_unlock(&qmp->phy_mutex);
 
-	return 0;
+	return ret;
 }
 
 static int qmp_combo_dp_power_off(struct phy *phy)
