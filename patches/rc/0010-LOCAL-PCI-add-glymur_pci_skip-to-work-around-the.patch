From e84c2e97e66a4e450d9fd1747f1f5e32f8f228f6 Mon Sep 17 00:00:00 2001
From: Jesse Casco <jesse.casco@gmail.com>
Date: Mon, 17 Aug 2026 18:30:33 -0400
Subject: [PATCH 010/100] LOCAL: PCI: add glymur_pci_skip to work around the

suspend_noirq SoC reset

(cherry picked from commit 6e8bc47df1e8a76ad7a4ecaa75b4c034046ea888)

Signed-off-by: Jesse Casco <jesse.casco@gmail.com>
---
 drivers/pci/pci-driver.c | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/drivers/pci/pci-driver.c b/drivers/pci/pci-driver.c
index 2398f03a77c1..8759846dc8dd 100644
--- a/drivers/pci/pci-driver.c
+++ b/drivers/pci/pci-driver.c
@@ -4,6 +4,7 @@
  * (C) Copyright 2007 Novell Inc.
  */
 
+#include <linux/moduleparam.h>
 #include <linux/pci.h>
 #include <linux/module.h>
 #include <linux/init.h>
@@ -824,6 +825,14 @@ static void pci_pm_complete(struct device *dev)
 #endif /* !CONFIG_PM_SLEEP */
 
 #if defined(CONFIG_SUSPEND) || defined(CONFIG_HIBERNATE_CALLBACKS)
+/*
+ * GLYMUR DIAGNOSTIC (2026-07-30, local diagnostic). See
+ * the project changelog. bit1 = skip pci_prepare_to_sleep (stay in D0),
+ * bit2 = skip the driver noirq callback, bit4 = skip pci_save_state (RISKY).
+ */
+static int glymur_pci_skip;
+core_param(glymur_pci_skip, glymur_pci_skip, int, 0644);
+
 /**
  * pci_pm_suspend_noirq_common - prepare a device to enter a low-power state
  * @pci_dev: pci device
@@ -835,14 +844,16 @@ static void pci_pm_complete(struct device *dev)
 static bool pci_pm_suspend_noirq_common(struct pci_dev *pci_dev)
 {
 	if (!pci_dev->state_saved) {
-		pci_save_state(pci_dev);
+		if (!(glymur_pci_skip & 4))
+			pci_save_state(pci_dev);
 
 		/*
 		 * If the device is a bridge with a child in D0 below it,
 		 * it needs to stay in D0, so check skip_bus_pm to avoid
 		 * putting it into a low-power state in that case.
 		 */
-		if (!pci_dev->skip_bus_pm && pci_power_manageable(pci_dev))
+		if (!pci_dev->skip_bus_pm && pci_power_manageable(pci_dev) &&
+		    !(glymur_pci_skip & 1))
 			pci_prepare_to_sleep(pci_dev);
 	}
 
@@ -971,7 +982,7 @@ static int pci_pm_suspend_noirq(struct device *dev)
 		goto set_unknown;
 	}
 
-	if (pm->suspend_noirq) {
+	if (pm->suspend_noirq && !(glymur_pci_skip & 2)) {
 		pci_power_t prev = pci_dev->current_state;
 		int error;
 
