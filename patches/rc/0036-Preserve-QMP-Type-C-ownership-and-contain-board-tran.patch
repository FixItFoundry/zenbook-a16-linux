+static int qmp_combo_reconfigure(struct qmp_combo *qmp,
+				 enum typec_orientation orientation,
+				 enum qmpphy_mode mode)
+{
+	enum typec_orientation old_orientation = qmp->orientation;
+	enum qmpphy_mode old_mode = qmp->qmpphy_mode;
+	int ret, rollback_ret;
+
+	if (qmp->config_valid && orientation == old_orientation && mode == old_mode)
+		return 0;
+	if (qmp->dp_powered_on)
+		return -EBUSY;
+
+	ret = qmp_combo_apply_typec(qmp, orientation, mode);
+	if (!ret)
+		return 0;
+
+	rollback_ret = qmp_combo_apply_typec(qmp, old_orientation, old_mode);
+	qmp->orientation = old_orientation;
+	qmp->qmpphy_mode = old_mode;
+	if (rollback_ret) {
+		qmp->config_valid = false;
+		dev_err(qmp->dev, "Type-C rollback failed: %d (request: %d)\n",
+			rollback_ret, ret);
+	}
+
+	return ret;
+}
