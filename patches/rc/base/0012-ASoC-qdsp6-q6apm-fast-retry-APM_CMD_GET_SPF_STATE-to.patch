From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jesse Casco <jesse.casco@gmail.com>
Date: Mon, 17 Aug 2026 18:32:22 -0400
Subject: [PATCH 13/24] ASoC: qdsp6: q6apm: fast-retry APM_CMD_GET_SPF_STATE to
 eliminate 5s boot timeout

(cherry picked from commit c005f881d5a27b72029dcac06d99630a6564aa99)
---
 sound/soc/qcom/qdsp6/audioreach.c | 30 ++++++++++++++------
 sound/soc/qcom/qdsp6/audioreach.h |  4 +++
 sound/soc/qcom/qdsp6/q6apm.c      | 47 +++++++++++++++++++++++++------
 sound/soc/qcom/qdsp6/q6apm.h      |  2 ++
 4 files changed, 66 insertions(+), 17 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index cce0ad31ff0c036e0cadd113e3a3e88b6344e02f..884722b2ed9272c3a97457a6ebcc3bd33b0ba3df 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -590,10 +590,11 @@ void *audioreach_alloc_graph_pkt(struct q6apm *apm,
 }
 EXPORT_SYMBOL_GPL(audioreach_alloc_graph_pkt);
 
-int audioreach_send_cmd_sync(struct device *dev, gpr_device_t *gdev,
-			     struct gpr_ibasic_rsp_result_t *result, struct mutex *cmd_lock,
-			     gpr_port_t *port, wait_queue_head_t *cmd_wait,
-			     const struct gpr_pkt *pkt, uint32_t rsp_opcode)
+int audioreach_send_cmd_sync_timeout(struct device *dev, gpr_device_t *gdev,
+				     struct gpr_ibasic_rsp_result_t *result, struct mutex *cmd_lock,
+				     gpr_port_t *port, wait_queue_head_t *cmd_wait,
+				     const struct gpr_pkt *pkt, uint32_t rsp_opcode,
+				     unsigned long timeout, bool quiet)
 {
 
 	const struct gpr_hdr *hdr = &pkt->hdr;
@@ -615,15 +616,17 @@ int audioreach_send_cmd_sync(struct device *dev, gpr_device_t *gdev,
 
 	if (rsp_opcode)
 		rc = wait_event_timeout(*cmd_wait, (result->opcode == hdr->opcode) ||
-					(result->opcode == rsp_opcode),	5 * HZ);
+					(result->opcode == rsp_opcode),	timeout);
 	else
-		rc = wait_event_timeout(*cmd_wait, (result->opcode == hdr->opcode), 5 * HZ);
+		rc = wait_event_timeout(*cmd_wait, (result->opcode == hdr->opcode), timeout);
 
 	if (!rc) {
-		dev_err(dev, "CMD timeout for [%x] opcode\n", hdr->opcode);
+		if (!quiet)
+			dev_err(dev, "CMD timeout for [%x] opcode\n", hdr->opcode);
 		rc = -ETIMEDOUT;
 	} else if (result->status > 0) {
-		dev_err(dev, "DSP returned error[%x] %x\n", hdr->opcode, result->status);
+		if (!quiet)
+			dev_err(dev, "DSP returned error[%x] %x\n", hdr->opcode, result->status);
 		rc = -EINVAL;
 	} else {
 		/* DSP successfully finished the command */
@@ -634,6 +637,17 @@ int audioreach_send_cmd_sync(struct device *dev, gpr_device_t *gdev,
 	mutex_unlock(cmd_lock);
 	return rc;
 }
+EXPORT_SYMBOL_GPL(audioreach_send_cmd_sync_timeout);
+
+int audioreach_send_cmd_sync(struct device *dev, gpr_device_t *gdev,
+			     struct gpr_ibasic_rsp_result_t *result, struct mutex *cmd_lock,
+			     gpr_port_t *port, wait_queue_head_t *cmd_wait,
+			     const struct gpr_pkt *pkt, uint32_t rsp_opcode)
+{
+	return audioreach_send_cmd_sync_timeout(dev, gdev, result, cmd_lock,
+						port, cmd_wait, pkt, rsp_opcode,
+						5 * HZ, false);
+}
 EXPORT_SYMBOL_GPL(audioreach_send_cmd_sync);
 
 int audioreach_graph_send_cmd_sync(struct q6apm_graph *graph, const struct gpr_pkt *pkt,
diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index 35541b2d8c99840563ec63a5bb584568b87a3135..b3e5c8c185db82c95ca6173abdfee59c32568fe4 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -1020,6 +1020,10 @@ int audioreach_tplg_init(struct snd_soc_component *component);
 
 /* Module specific */
 void audioreach_graph_free_buf(struct q6apm_graph *graph);
+int audioreach_send_cmd_sync_timeout(struct device *dev, gpr_device_t *gdev, struct gpr_ibasic_rsp_result_t *result,
+				     struct mutex *cmd_lock, gpr_port_t *port, wait_queue_head_t *cmd_wait,
+				     const struct gpr_pkt *pkt, uint32_t rsp_opcode,
+				     unsigned long timeout, bool quiet);
 int audioreach_send_cmd_sync(struct device *dev, gpr_device_t *gdev, struct gpr_ibasic_rsp_result_t *result,
 			     struct mutex *cmd_lock, gpr_port_t *port, wait_queue_head_t *cmd_wait,
 			     const struct gpr_pkt *pkt, uint32_t rsp_opcode);
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index f167b9dae3fa140989f7f3a39d62c028d37ec66a..282b3b450da39f5052b87908014397a976f42d37 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -29,13 +29,21 @@ struct apm_graph_mgmt_cmd {
 
 static struct q6apm *g_apm;
 
-int q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
-			uint32_t rsp_opcode)
+int q6apm_send_cmd_sync_timeout(struct q6apm *apm, const struct gpr_pkt *pkt,
+				uint32_t rsp_opcode, unsigned long timeout, bool quiet)
 {
 	gpr_device_t *gdev = apm->gdev;
 
-	return audioreach_send_cmd_sync(&gdev->dev, gdev, &apm->result, &apm->lock,
-					NULL, &apm->wait, pkt, rsp_opcode);
+	return audioreach_send_cmd_sync_timeout(&gdev->dev, gdev, &apm->result, &apm->lock,
+						NULL, &apm->wait, pkt, rsp_opcode,
+						timeout, quiet);
+}
+EXPORT_SYMBOL_GPL(q6apm_send_cmd_sync_timeout);
+
+int q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
+			uint32_t rsp_opcode)
+{
+	return q6apm_send_cmd_sync_timeout(apm, pkt, rsp_opcode, 5 * HZ, false);
 }
 
 static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, uint32_t graph_id)
@@ -142,12 +150,33 @@ static void q6apm_put_audioreach_graph(struct kref *ref)
 
 static int q6apm_get_apm_state(struct q6apm *apm)
 {
-	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(0,
-								APM_CMD_GET_SPF_STATE, 0);
-	if (IS_ERR(pkt))
-		return PTR_ERR(pkt);
+	int ret, retries = 50;
+
+	/*
+	 * During boot the APM service may take a short time after GPR registration
+	 * before responding to GET_SPF_STATE. Instead of a single 5-second blocking
+	 * wait on an unhandled initial packet, poll with short timeouts (100ms) so
+	 * we unblock as soon as the DSP APM service is ready.
+	 */
+	while (retries--) {
+		struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(0,
+									APM_CMD_GET_SPF_STATE, 0);
+		if (IS_ERR(pkt))
+			return PTR_ERR(pkt);
+
+		ret = q6apm_send_cmd_sync_timeout(apm, pkt, APM_CMD_RSP_GET_SPF_STATE,
+						  msecs_to_jiffies(100), true);
+		if (!ret && apm->state) {
+			dev_info(apm->dev, "APM service ready (state: 0x%x)\n", apm->state);
+			return apm->state;
+		}
+
+		if (ret != -ETIMEDOUT)
+			break;
+	}
 
-	q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_GET_SPF_STATE);
+	if (!apm->state)
+		dev_err(apm->dev, "APM service did not become ready (state: 0x%x)\n", apm->state);
 
 	return apm->state;
 }
diff --git a/sound/soc/qcom/qdsp6/q6apm.h b/sound/soc/qcom/qdsp6/q6apm.h
index 5cb51ca491dc4fac7d910c3e26ea36d9831de1ca..3fdaa9ce3b4ed06f1258d6ec296f3fdb83d1025f 100644
--- a/sound/soc/qcom/qdsp6/q6apm.h
+++ b/sound/soc/qcom/qdsp6/q6apm.h
@@ -147,6 +147,8 @@ int q6apm_alloc_fragments(struct q6apm_graph *graph,
 int q6apm_free_fragments(struct q6apm_graph *graph, unsigned int dir);
 int q6apm_unmap_memory_fixed_region(struct device *dev, unsigned int graph_id);
 /* Helpers */
+int q6apm_send_cmd_sync_timeout(struct q6apm *apm, const struct gpr_pkt *pkt,
+				uint32_t rsp_opcode, unsigned long timeout, bool quiet);
 int q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
 			uint32_t rsp_opcode);
 
