+static void qcom_swrm_recover_work(struct work_struct *work)
+{
+	struct qcom_swrm_ctrl *ctrl =
+		container_of(work, struct qcom_swrm_ctrl, recovery_work);
+	unsigned long time_left;
+	int generation, ret;
+	bool attached;
+
+	mutex_lock(&qcom_swrm_probe_recovery_lock);
+	mutex_lock(&ctrl->recovery_lock);
+	if (!READ_ONCE(ctrl->recovery_ready) || ctrl->active_streams)
+		goto unlock;
+
+	generation = atomic_read(&ctrl->recovery_pending);
+	if (!generation)
+		goto unlock;
+	ctrl->recovery_failed = false;
+
+	/* The fault was reported by a threaded IRQ; let it finish first. */
+	synchronize_irq(ctrl->irq);
+
+	ret = pm_runtime_resume_and_get(ctrl->dev);
+	if (ret < 0) {
+		dev_err_ratelimited(ctrl->dev,
+				    "deferred clash recovery: runtime resume failed: %d\n",
+				    ret);
+		if (atomic_cmpxchg(&ctrl->recovery_pending, generation, 0) == generation)
+			ctrl->recovery_failed = true;
+		goto unlock;
+	}
+
+	/* A reset during an open stream drops its port routing. */
+	reinit_completion(&ctrl->enumeration);
+	ctrl->reg_write(ctrl, SWRM_COMP_SW_RESET, 0x01);
+	usleep_range(2000, 2050);
+	qcom_swrm_init(ctrl);
+	time_left = wait_for_completion_timeout(&ctrl->enumeration,
+					     msecs_to_jiffies(TIMEOUT_MS));
+	if (!time_left)
+		dev_warn(ctrl->dev, "deferred clash recovery: enumeration timeout\n");
+	synchronize_irq(ctrl->irq);
+
+	qcom_swrm_get_device_status(ctrl);
+	qcom_swrm_enumerate(&ctrl->bus);
+	sdw_handle_slave_status(&ctrl->bus, ctrl->status);
+	attached = qcom_swrm_all_slaves_online(ctrl);
+	if (!attached) {
+		qcom_swrm_reprobe_unattached_slaves(ctrl);
+		/* Reprobe can release reset before the attach IRQ is handled. */
+		attached = wait_event_timeout(ctrl->slaves_wait,
+					      qcom_swrm_all_slaves_online(ctrl),
+					      msecs_to_jiffies(TIMEOUT_MS)) > 0;
+	}
+
+	if (atomic_cmpxchg(&ctrl->recovery_pending, generation, 0) == generation)
+		ctrl->recovery_failed = !attached;
+
+	if (attached) {
+		dev_info(ctrl->dev, "deferred clash recovery: slaves attached\n");
+	} else {
+		/* Keep the clash masked; a failed attempt must not loop on startup. */
+		ctrl->intr_mask &= ~SWRM_INTERRUPT_STATUS_MASTER_CLASH_DET;
+		ctrl->reg_write(ctrl,
+				ctrl->reg_layout[SWRM_REG_INTERRUPT_CPU_EN],
+				ctrl->intr_mask);
+		dev_err(ctrl->dev, "deferred clash recovery: slaves still missing\n");
+	}
+
+	pm_runtime_mark_last_busy(ctrl->dev);
+	pm_runtime_put_autosuspend(ctrl->dev);
+unlock:
+	mutex_unlock(&ctrl->recovery_lock);
+	mutex_unlock(&qcom_swrm_probe_recovery_lock);
+}
