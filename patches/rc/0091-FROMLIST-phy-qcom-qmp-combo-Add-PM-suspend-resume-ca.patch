From 8e074b83ae8cfc8e1f3e930d0c1d62e141646417 Mon Sep 17 00:00:00 2001
From: Prashanth K <prashanth.k@oss.qualcomm.com>
Date: Wed, 7 Oct 2026 15:56:00 +0530
Subject: [PATCH 091/100] FROMLIST: phy: qcom: qmp-combo: Add PM suspend/resume
 callbacks

Currently when we perform system suspend, the USB clocks are not
turned off, this leads to power leakage. Prevent this by adding
PM suspend/resume callbacks for the qmp-combo phy which toggles
clocks on/off correspondingly.

Link: https://lore.kernel.org/all/20261022104321.306679-2-prashanth.k@oss.qualcomm.com/
(cherry picked from commit 0d348e9f0a31a8c54c1485e8fbfe6bf64c7a094e)
Signed-off-by: Prashanth K <prashanth.k@oss.qualcomm.com>
---
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 496bf83869c1..8e3e680725ed 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -4902,9 +4902,26 @@ static int __maybe_unused qmp_combo_runtime_resume(struct device *dev)
 	return ret;
 }
 
+static int __maybe_unused qmp_combo_pm_suspend(struct device *dev)
+{
+	if (pm_runtime_suspended(dev))
+		return 0;
+
+	return qmp_combo_runtime_suspend(dev);
+}
+
+static int __maybe_unused qmp_combo_pm_resume(struct device *dev)
+{
+	if (pm_runtime_suspended(dev))
+		return 0;
+
+	return qmp_combo_runtime_resume(dev);
+}
+
 static const struct dev_pm_ops qmp_combo_pm_ops = {
 	SET_RUNTIME_PM_OPS(qmp_combo_runtime_suspend,
 			   qmp_combo_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(qmp_combo_pm_suspend, qmp_combo_pm_resume)
 };
 
 static int qmp_combo_reset_init(struct qmp_combo *qmp)
