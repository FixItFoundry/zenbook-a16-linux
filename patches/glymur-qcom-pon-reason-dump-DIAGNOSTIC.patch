diff --git a/drivers/power/reset/qcom-pon.c b/drivers/power/reset/qcom-pon.c
index 7e108982a..efa19d5c0 100644
--- a/drivers/power/reset/qcom-pon.c
+++ b/drivers/power/reset/qcom-pon.c
@@ -19,6 +19,31 @@
 
 #define NO_REASON_SHIFT			0
 
+/*
+ * GLYMUR DIAGNOSTIC - not for upstream.
+ *
+ * The Zenbook A16 hard-resets on eDP panel power-down and Linux emits no fault
+ * at all (netconsole with an empty queue and ramoops both come back blank), so
+ * the SoC is being reset by something outside Linux - TZ, a secure watchdog, or
+ * hardware. The PMIC latches *why* it was last powered on / reset, which names
+ * that agent, and nothing in Linux reads those registers.
+ *
+ * Mainline has no register map for the gen3 (pmk8350/pmk8850) PON reason
+ * registers and the vendor offsets are not published, so DO NOT guess them:
+ * this dumps both PON peripherals wholesale and lets the values be decoded
+ * afterwards. PON_SUBTYPE (0x05) identifies which is which - 0x08 = PBS,
+ * 0x09 = HLOS - and is the one offset mainline does document
+ * (drivers/input/misc/pm8941-pwrkey.c).
+ *
+ * Read-only. Reload with rmmod/modprobe to re-dump; the reason registers are
+ * latched at power-on, so the values are stable for the life of the boot.
+ */
+#define PON_REV2			0x01
+#define PON_SUBTYPE			0x05
+
+#define PON_DUMP_LEN			0x100
+#define PON_DUMP_STRIDE			16
+
 struct qcom_pon {
 	struct device *dev;
 	struct regmap *regmap;
@@ -27,6 +52,39 @@ struct qcom_pon {
 	long reason_shift;
 };
 
+static void qcom_pon_dump(struct device *dev, struct regmap *regmap,
+			  const char *what, u32 base)
+{
+	unsigned int rev2, subtype;
+	u8 buf[PON_DUMP_STRIDE];
+	int i;
+
+	if (regmap_read(regmap, base + PON_REV2, &rev2) ||
+	    regmap_read(regmap, base + PON_SUBTYPE, &subtype)) {
+		dev_info(dev, "GLYMUR-PON: %s @0x%04x: not readable\n",
+			 what, base);
+		return;
+	}
+
+	dev_info(dev, "GLYMUR-PON: %s @0x%04x rev2=0x%02x subtype=0x%02x%s\n",
+		 what, base, rev2, subtype,
+		 subtype == 0x08 ? " (GEN3_PBS)" :
+		 subtype == 0x09 ? " (GEN3_HLOS)" : "");
+
+	/*
+	 * One chunk at a time: a single unimplemented register inside the
+	 * peripheral would fail a 256-byte bulk read and lose the whole dump.
+	 */
+	for (i = 0; i < PON_DUMP_LEN; i += PON_DUMP_STRIDE) {
+		if (regmap_bulk_read(regmap, base + i, buf, sizeof(buf)))
+			dev_info(dev, "GLYMUR-PON: %s +%02x: <read failed>\n",
+				 what, i);
+		else
+			dev_info(dev, "GLYMUR-PON: %s +%02x: %16ph\n",
+				 what, i, buf);
+	}
+}
+
 static int qcom_pon_reboot_mode_write(struct reboot_mode_driver *reboot,
 				    unsigned int magic)
 {
@@ -67,6 +125,25 @@ static int qcom_pon_probe(struct platform_device *pdev)
 	if (error)
