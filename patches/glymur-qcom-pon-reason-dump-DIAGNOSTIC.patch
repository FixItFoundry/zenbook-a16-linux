+		u32 base;
+		int i;
+
+		for (i = 0; !of_property_read_u32_index(pdev->dev.of_node,
+							"reg", i, &base); i++) {
+			if (of_property_read_string_index(pdev->dev.of_node,
+							  "reg-names", i, &name))
+				name = "reg";
+			qcom_pon_dump(&pdev->dev, pon->regmap, name, base);
+		}
+	}
+
 	reason_shift = (long)of_device_get_match_data(&pdev->dev);
 
 	if (reason_shift != NO_REASON_SHIFT) {
