 /delete-node/ &pmh0104_l_e1;
-/delete-node/ &pmh0104_l1_thermal;
+/delete-node/ &{/thermal-zones/pmh0104-l1-thermal};
 /delete-node/ &pmh0110_h_e0;
-/delete-node/ &pmh0110_h0_thermal;
+/delete-node/ &{/thermal-zones/pmh0110-h0-thermal};
 
