+
+/*
+ * GLYMUR-A16: make the SCMI core poll instead of waiting on the mailbox doorbell.
+ *
+ * scmi-cpufreq probed -110 (-ETIMEDOUT) for this project's entire life. Measured
+ * with SCMI RAW on 2026-07-30: the PDP0/CPUCP firmware answers protocol 0x13
+ * (Performance) in shared memory but NEVER rings the doorbell for it. The same
+ * message returns status 0 in polling mode and hangs forever in interrupt mode;
+ * 8 messages sent in IRQ mode moved IRQ 156 from 9 to 16 (one per reply) and
+ * ZERO times for 0x13.
+ *
+ * arm,no-completion-irq is a documented upstream boolean - no kernel patch needed.
+ * Result: three SCMI performance domains, scaling_driver = scmi, and the
+ * cpufreq-cpu0/6/12 cooling devices appear unaided.
+ *
+ * The scmi node upstream carries no label, so it is reached by path.
+ *
+ * Back-ported to source 2026-08-02; previously only in the compiled DTB.
+ */
+&{/firmware/scmi} {
+	arm,no-completion-irq;
+};
+
+/*
+ * GLYMUR-A16: thermal actuation. Bind the cpufreq cooling devices that the
+ * arm,no-completion-irq fix causes the kernel to create (cpufreq-cpu0/6/12) to a
+ * passive trip on every CPU and CPU-LLC zone. Upstream ships only the 115 C
+ * critical trip, so without this Linux has cooling capability and no actuation.
+ *
+ * Cluster map: the cpu-0-N and cpullc-0-N zones bind cpu0 (cpus 0-5), the cpu-1-N
+ * and cpullc-1-N zones bind cpu6 (cpus 6-11), and the cpu-2-N, cpullc-2-0 and
+ * cpuillc-2-1 zones bind cpu12 (cpus 12-17).
+ *
+ * polling-delay-passive is REQUIRED - without it the thermal core never
+ * re-evaluates the zone once the passive trip is crossed, so cur_state never
+ * steps back down. Verified against the running DTB on 2026-08-02.
+ *
+ * NOTE: this binds 42 zones where the hand-edited DTB on the laptop binds 41.
+ * Upstream glymur.dtsi contains a typo'd zone name, cpuillc-2-1-thermal (three
+ * i's), which the hand edit's cpullc-* pattern missed. It is a real zone with a
+ * real sensor, so it is bound here too.
+ *
+ * Back-ported to source 2026-08-02 and diffed against the live
+ * glymur-a16-hdmi-nocomaux.dtb: trip temperature, hysteresis, polling delay and
+ * cooling-device args all match.
+ */
+
+&{/thermal-zones/cpu-0-0-0-thermal} {
+	polling-delay-passive = <100>;
+
+	trips {
+		cpu_0_0_0_alert: cpu-0-0-0-alert {
+			temperature = <95000>;
+			hysteresis = <1000>;
+			type = "passive";
+		};
+	};
+
+	cooling-maps {
+		map0 {
+			trip = <&cpu_0_0_0_alert>;
+			cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+		};
+	};
+};
+
+&{/thermal-zones/cpu-0-0-1-thermal} {
+	polling-delay-passive = <100>;
+
+	trips {
+		cpu_0_0_1_alert: cpu-0-0-1-alert {
+			temperature = <95000>;
+			hysteresis = <1000>;
+			type = "passive";
+		};
+	};
+
+	cooling-maps {
+		map0 {
+			trip = <&cpu_0_0_1_alert>;
+			cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+		};
+	};
+};
+
+&{/thermal-zones/cpu-0-1-0-thermal} {
