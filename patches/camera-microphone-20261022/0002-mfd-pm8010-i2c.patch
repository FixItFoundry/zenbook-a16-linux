+        - vdd-l5-supply
+        - vdd-l6-supply
+        - vdd-l7-supply
+        - gpio-controller
+        - "#gpio-cells"
+        - gpio-ranges
+        - interrupt-controller
+        - "#interrupt-cells"
+        - "#thermal-sensor-cells"
 
 additionalProperties: false
 
